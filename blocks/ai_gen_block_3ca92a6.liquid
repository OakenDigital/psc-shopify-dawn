{% doc %}
  @prompt
    Create a NEW replacement PSC Motorsports Install guide table on the currently selected psc-install-guides template. Preserve the existing table untouched. Essential requirement: rows must be individually reorderable in the theme editor, not fixed Row 1 through Row 21 settings. Use independent repeatable row blocks with native editor drag-and-drop ordering if supported. Each row must keep its four editable text cells and unique editable PDF URL together when moved. Start with 21 rows and allow adding/removing rows. Table has five editable column headings. Fifth column displays one shared Download image selected by a shared image picker, with each row image linked to that row's unique PDF URL; blank URL means unlinked image. Keep image width editable. Reuse existing table content and Download image if accessible without altering original; otherwise leave fields empty rather than invent content or URLs. Match site's inherited font family, colors, and button/image styling. Use slightly smaller readable body type, default 14px with an editable font-size control, comfortable line height and cell padding; headers should remain clear and consistent with site. Accessible semantic table with horizontally scrollable container on mobile and no page overflow. Do not change About Us content or assignment, it is only the preview resource. If the generator cannot create native reorderable row blocks, do not silently build another fixed-row table; instead provide an explicit editable row-order setting listing stable row IDs in display order, preserving each row's data and URL together and validating duplicates/invalid IDs. Prefer native draggable rows over this fallback.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign order_ids = block.settings.row_order | split: ',' %}
{% capture valid_ids %}|{% for n in (1..21) %}r{{ n }}|{% endfor %}{% endcapture %}

{% style %}
  .psc-guide-{{ ai_gen_id }} {
  display: block;
  width: {{ block.settings.desktop_width_percent }}%;
  max-width: 100%;
  margin-left: auto;
  margin-right: auto;
  color: rgb(var(--color-foreground));
  font-family: var(--font-body-family);
}
  .psc-guide-{{ ai_gen_id }}__scroll { width:100%; max-width:100%; overflow-x:auto; overscroll-behavior-inline:contain; -webkit-overflow-scrolling:touch; border:1px solid rgba(var(--color-foreground),.25); }
  .psc-guide-{{ ai_gen_id }} table { width:100%; min-width:680px; border-collapse:collapse; font-family:inherit; font-size:{{ block.settings.body_font_size }}px; line-height:1.5; }
  .psc-guide-{{ ai_gen_id }} th,.psc-guide-{{ ai_gen_id }} td { padding:{{ block.settings.cell_padding }}px; text-align:left; vertical-align:middle; border-bottom:1px solid rgba(var(--color-foreground),.2); }
  .psc-guide-{{ ai_gen_id }} th { font-weight:700; background:rgba(var(--color-foreground),.06); }
  .psc-guide-{{ ai_gen_id }} .psc-guide-{{ ai_gen_id }}__image { display:inline-block; width:{{ block.settings.image_width }}px; max-width:100%; height:auto; }
  .psc-guide-{{ ai_gen_id }} .psc-guide__placeholder { display:inline-block; width:{{ block.settings.image_width }}px; max-width:100%; }
  .psc-guide-{{ ai_gen_id }} .psc-guide__placeholder svg { width:100%; height:auto; }
  .psc-guide-{{ ai_gen_id }} a { color:inherit; }
  .psc-guide-{{ ai_gen_id }} a:focus-visible { outline:2px solid currentColor; outline-offset:3px; }
  @media(max-width:749px) { .psc-guide-{{ ai_gen_id }} { width:100%; } }
    .psc-guide-{{ ai_gen_id }} th:nth-child(5),
  .psc-guide-{{ ai_gen_id }} td:nth-child(5) {
    width: 110px;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .psc-guide-{{ ai_gen_id }} td:nth-child(5) {
    text-align: center;
  }
{% endstyle %}

<div class="psc-guide-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="psc-guide-{{ ai_gen_id }}__scroll" role="region" aria-label="{{ block.settings.table_label | escape }}" tabindex="0">
    <table><caption class="visually-hidden">{{ block.settings.table_label | escape }}</caption>
      <thead><tr><th scope="col">{{ block.settings.heading_one | escape }}</th><th scope="col">{{ block.settings.heading_two | escape }}</th><th scope="col">{{ block.settings.heading_three | escape }}</th><th scope="col">{{ block.settings.heading_four | escape }}</th><th scope="col">{{ block.settings.heading_five | escape }}</th></tr></thead>
      <tbody>
        {% assign rendered_ids = '|' %}
        {% for raw_id in order_ids %}
          {% assign row_id = raw_id | strip | downcase %}
          {% capture check_id %}|{{ row_id }}|{% endcapture %}
          {% if valid_ids contains check_id %}
            {% unless rendered_ids contains check_id %}
              {% assign rendered_ids = rendered_ids | append: row_id | append: '|' %}
              {% assign row_num = row_id | remove: 'r' | plus: 0 %}
              {% assign c1key = 'row_' | append: row_num | append: '_cell_1' %}
              {% assign c2key = 'row_' | append: row_num | append: '_cell_2' %}
              {% assign c3key = 'row_' | append: row_num | append: '_cell_3' %}
              {% assign c4key = 'row_' | append: row_num | append: '_cell_4' %}
              {% assign urlkey = 'row_' | append: row_num | append: '_pdf' %}
              <tr><td>{{ block.settings[c1key] | escape }}</td><td>{{ block.settings[c2key] | escape }}</td><td>{{ block.settings[c3key] | escape }}</td><td>{{ block.settings[c4key] | escape }}</td><td>{% if block.settings.download_image != blank %}{% if block.settings[urlkey] != blank %}<a href="{{ block.settings[urlkey] }}" target="_blank" rel="noopener">{% endif %}<img class="psc-guide-{{ ai_gen_id }}__image" src="{{ block.settings.download_image | image_url: width: 500 }}" alt="{{ block.settings.download_image.alt | default: 'Download guide' | escape }}" loading="lazy">{% if block.settings[urlkey] != blank %}</a>{% endif %}{% else %}<span class="psc-guide__placeholder" aria-label="Select a shared download image">{{ 'image' | placeholder_svg_tag }}</span>{% endif %}</td></tr>
            {% endunless %}
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

