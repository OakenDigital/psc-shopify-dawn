    },
    {
      "type": "url",
      "id": "job_url_1",
      "label": "Job description link"
    },
    {
      "type": "header",
      "content": "CNC machinist"
    },
    {
      "type": "text",
      "id": "role_2",
      "label": "Role title",
      "default": "CNC Machinist"
    },
    {
      "type": "text",
      "id": "link_label_2",
      "label": "Link label",
      "default": "View Job Description →"
    },
    {
      "type": "url",
      "id": "job_url_2",
      "label": "Job description link"
    },
    {
