{% doc %}
  @prompt
    Create a complete PSC Motorsports Installation Guide page block for the Shopify theme editor with this specific layout:
    
    COVER PAGE LAYOUT:
    Two-column layout side by side:
    - LEFT COLUMN: A square/portrait image box with a rounded-corner border showing the kit product photo — editable image field labeled "Kit Image"
    - RIGHT COLUMN: Four fields stacked vertically with generous spacing between each:
      1. "Product Title" — large bold red text (e.g. "Accessory Drive Conversion Kit")
      2. "Product Application" — medium bold dark text (e.g. "GM Gen 5 LT Engine")
      3. "Product Year" — medium dark text (e.g. "2014+")
      4. "Part #" — smaller text with red square bullet markers, supports multiple part numbers on separate lines
    - Above the two columns: PSC logo centered, then a small caps eyebrow label with decorative horizontal rules (editable field: "Guide Category")
    - Below the two columns: bold centered "INSTALLATION GUIDE" label
    
    INTERIOR PAGE HEADER (used on all interior sections):
    - Diagonal black-to-gray stripe/chevron band across the top
    - PSC logo centered below the band
    
    TABLE OF CONTENTS SECTION:
    - Bold centered "TABLE OF CONTENTS" heading
    - Gray pill/tab-style entries with section name and page range
    - Bulleted sub-items under each entry, editable as rich text
    
    BEFORE YOU GET STARTED SECTION:
    - Interior header
    - Bold centered section title (editable)
    - Rich text body with red inline hyperlink support
    
    WHAT'S IN THE KIT SECTION:
    - Interior header
    - Gray banner category headers with bulleted part number + description lists, editable as rich text
    
    STEP-BY-STEP INSTALLATION SECTION:
    - Interior header + bold centered "INSTALLATION" heading
    - REPEATABLE STEPS — merchant can add as many steps as needed, each step contains:
      - Gray pill-style numbered step header (editable)
      - Bold sub-label (editable)
      - Bullet point instructions (editable rich text)
      - Step photo with circled step number overlay (editable image)
      - Two-column layout: instructions left, photo right
    
    CONTACT US SECTION:
    - Centered PSC logo
    - Bold centered "CONTACT US" heading
    - Red centered subheading (editable)
    - Phone, Hours, Email fields (editable, centered)
    - Bold large centered website URL field
    
    DESIGN:
    - Red accent #CC0000
    - Gray pill/tab headers throughout
    - Bold condensed sans-serif (Barlow Condensed from Google Fonts)
    - White background
    - All fields editable in Shopify theme editor settings
    - Self-contained block that works on any Shopify page
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.psc-guide-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:auto;background:#fff;color:#171717;font-family:{{ block.settings.body_font.family }},Arial,sans-serif;line-height:1.55}.psc-guide-{{ ai_gen_id }} h1,.psc-guide-{{ ai_gen_id }} h2,.psc-guide-{{ ai_gen_id }} h3{font-family:{{ block.settings.heading_font.family }},Arial,sans-serif;font-weight:700;letter-spacing:.04em}.psc-guide-inner-{{ ai_gen_id }}{max-width:1180px;margin:auto;padding:56px 6%}.psc-guide-logo-{{ ai_gen_id }}{display:block;width:{{ block.settings.logo_width }}px;max-width:70%;height:auto;margin:0 auto 24px}.psc-guide-eyebrow-{{ ai_gen_id }}{display:flex;align-items:center;gap:18px;justify-content:center;color:#555;text-transform:uppercase;font-size:12px;letter-spacing:.18em;font-weight:700}.psc-guide-eyebrow-{{ ai_gen_id }}:before,.psc-guide-eyebrow-{{ ai_gen_id }}:after{content:'';height:1px;background:#777;flex:1}.psc-guide-cover-grid-{{ ai_gen_id }},.psc-guide-step-grid-{{ ai_gen_id }}{display:grid;grid-template-columns:1fr 1fr;gap:9%;align-items:center;margin-top:42px}.psc-guide-kit-image-{{ ai_gen_id }}{aspect-ratio:1;border:1px solid #bbb;border-radius:18px;overflow:hidden;background:#f2f2f2}.psc-guide-kit-image-{{ ai_gen_id }} img,.psc-guide-step-photo-{{ ai_gen_id }} img{width:100%;height:100%;object-fit:cover;display:block}.psc-guide-placeholder-{{ ai_gen_id }}{height:100%;display:flex;align-items:center;justify-content:center;position:relative;color:#666}.psc-guide-placeholder-{{ ai_gen_id }} svg{width:100%;height:100%}.psc-guide-empty-{{ ai_gen_id }}{position:absolute;bottom:18px;background:#fff;padding:6px 10px;font-size:12px}.psc-guide-cover-info-{{ ai_gen_id }}{display:grid;gap:28px}.psc-guide-cover-title-{{ ai_gen_id }}{color:#c00;font-size:clamp(34px,5vw,68px);line-height:.98;margin:0}.psc-guide-application-{{ ai_gen_id }}{font-size:24px;font-weight:700}.psc-guide-year-{{ ai_gen_id }}{font-size:22px}.psc-guide-parts-{{ ai_gen_id }} p{margin:0 0 8px}.psc-guide-parts-{{ ai_gen_id }} p:before{content:'';display:inline-block;width:9px;height:9px;background:#c00;margin-right:10px}.psc-guide-cover-label-{{ ai_gen_id }},.psc-guide-section-title-{{ ai_gen_id }}{text-align:center}.psc-guide-cover-label-{{ ai_gen_id }}{margin:58px 0 0}.psc-guide-section-{{ ai_gen_id }}{border-top:1px solid #ddd}.psc-guide-interior-header-{{ ai_gen_id }}{padding:0 6% 22px}.psc-guide-stripe-{{ ai_gen_id }}{height:78px;background:repeating-linear-gradient(135deg,#111 0,#111 28px,#666 28px,#666 56px,#d0d0d0 56px,#d0d0d0 82px)}.psc-guide-section-title-{{ ai_gen_id }}{font-size:34px;margin-bottom:35px}.psc-guide-pill-{{ ai_gen_id }}{background:#e8e8e8;border-radius:999px;padding:12px 22px;font-weight:700;display:flex;justify-content:space-between;gap:20px}.psc-guide-toc-{{ ai_gen_id }}{display:grid;gap:18px;max-width:760px;margin:auto}.psc-guide-richtext-{{ ai_gen_id }} a{color:#c00;text-decoration:underline}.psc-guide-banner-{{ ai_gen_id }}{background:#e8e8e8;border-radius:8px;padding:13px 20px;font-weight:700;margin:25px 0 10px}.psc-guide-step-{{ ai_gen_id }}{margin-bottom:48px}.psc-guide-step-photo-{{ ai_gen_id }}{position:relative;aspect-ratio:4/3;border-radius:12px;overflow:hidden;background:#eee}.psc-guide-step-number-{{ ai_gen_id }}{position:absolute;top:14px;left:14px;width:42px;height:42px;border:3px solid #c00;border-radius:50%;background:#fff;color:#c00;display:grid;place-items:center;font-weight:700}.psc-guide-contact-{{ ai_gen_id }}{text-align:center}.psc-guide-contact-subheading-{{ ai_gen_id }}{color:#c00;font-weight:700;font-size:20px}.psc-guide-website-{{ ai_gen_id }}{font-size:clamp(28px,5vw,56px);font-weight:700;margin-top:28px}@media(max-width:749px){.psc-guide-cover-grid-{{ ai_gen_id }},.psc-guide-step-grid-{{ ai_gen_id }}{grid-template-columns:1fr;gap:30px}.psc-guide-inner-{{ ai_gen_id }}{padding:38px 5%}.psc-guide-cover-title-{{ ai_gen_id }}{font-size:42px}}{% endstyle %}
<div class="psc-guide-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
<section><div class="psc-guide-inner-{{ ai_gen_id }}">{% if block.settings.logo %}<img class="psc-guide-logo-{{ ai_gen_id }}" src="{{ block.settings.logo | image_url: width: 600 }}" alt="{{ shop.name | escape }}">{% endif %}<div class="psc-guide-eyebrow-{{ ai_gen_id }}">{{ block.settings.guide_category }}</div><div class="psc-guide-cover-grid-{{ ai_gen_id }}"><div class="psc-guide-kit-image-{{ ai_gen_id }}">{% if block.settings.kit_image %}<img src="{{ block.settings.kit_image | image_url: width: 1200 }}" alt="{{ block.settings.kit_image.alt | escape }}">{% else %}<div class="psc-guide-placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}<span class="psc-guide-empty-{{ ai_gen_id }}">Add kit image</span></div>{% endif %}</div><div class="psc-guide-cover-info-{{ ai_gen_id }}"><h1 class="psc-guide-cover-title-{{ ai_gen_id }}">{{ block.settings.product_title }}</h1><div class="psc-guide-application-{{ ai_gen_id }}">{{ block.settings.product_application }}</div><div class="psc-guide-year-{{ ai_gen_id }}">{{ block.settings.product_year }}</div><div class="psc-guide-parts-{{ ai_gen_id }}">{{ block.settings.part_numbers }}</div></div></div><h2 class="psc-guide-cover-label-{{ ai_gen_id }}">{{ block.settings.cover_label }}</h2></div></section>
{% for section_type in (1..4) %}<section class="psc-guide-section-{{ ai_gen_id }}"><div class="psc-guide-interior-header-{{ ai_gen_id }}"><div class="psc-guide-stripe-{{ ai_gen_id }}"></div>{% if block.settings.logo %}<img class="psc-guide-logo-{{ ai_gen_id }}" src="{{ block.settings.logo | image_url: width: 500 }}" alt="{{ shop.name | escape }}">{% endif %}</div><div class="psc-guide-inner-{{ ai_gen_id }}">{% if section_type == 1 %}<h2 class="psc-guide-section-title-{{ ai_gen_id }}">{{ block.settings.toc_title }}</h2><div class="psc-guide-toc-{{ ai_gen_id }}">{% for i in (1..4) %}{% assign tk = 'toc_' | append: i | append: '_title' %}{% assign rk = 'toc_' | append: i | append: '_range' %}{% assign ik = 'toc_' | append: i | append: '_items' %}<div><div class="psc-guide-pill-{{ ai_gen_id }}"><span>{{ block.settings[tk] }}</span><span>{{ block.settings[rk] }}</span></div><div class="psc-guide-richtext-{{ ai_gen_id }}">{{ block.settings[ik] }}</div></div>{% endfor %}</div>{% elsif section_type == 2 %}<h2 class="psc-guide-section-title-{{ ai_gen_id }}">{{ block.settings.before_title }}</h2><div class="psc-guide-richtext-{{ ai_gen_id }}">{{ block.settings.before_body }}</div>{% elsif section_type == 3 %}<h2 class="psc-guide-section-title-{{ ai_gen_id }}">{{ block.settings.kit_title }}</h2>{% for i in (1..3) %}{% assign hk = 'kit_' | append: i | append: '_header' %}{% assign bk = 'kit_' | append: i | append: '_body' %}<div class="psc-guide-banner-{{ ai_gen_id }}">{{ block.settings[hk] }}</div><div class="psc-guide-richtext-{{ ai_gen_id }}">{{ block.settings[bk] }}</div>{% endfor %}{% else %}<h2 class="psc-guide-section-title-{{ ai_gen_id }}">{{ block.settings.install_title }}</h2>{% for i in (1..4) %}{% assign ek = 'step_' | append: i | append: '_enabled' %}{% assign hk = 'step_' | append: i | append: '_header' %}{% assign lk = 'step_' | append: i | append: '_label' %}{% assign bk = 'step_' | append: i | append: '_body' %}{% assign ik = 'step_' | append: i | append: '_image' %}{% if block.settings[ek] %}<article class="psc-guide-step-{{ ai_gen_id }}"><div class="psc-guide-pill-{{ ai_gen_id }}">{{ block.settings[hk] }}<span>{{ i }}</span></div><div class="psc-guide-step-grid-{{ ai_gen_id }}"><div><h3>{{ block.settings[lk] }}</h3><div class="psc-guide-richtext-{{ ai_gen_id }}">{{ block.settings[bk] }}</div></div><div class="psc-guide-step-photo-{{ ai_gen_id }}">{% if block.settings[ik] %}<img src="{{ block.settings[ik] | image_url: width: 1000 }}" alt="Step {{ i }}">{% else %}<div class="psc-guide-placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}<span class="psc-guide-empty-{{ ai_gen_id }}">Add step photo</span></div>{% endif %}<span class="psc-guide-step-number-{{ ai_gen_id }}">{{ i }}</span></div></div></article>{% endif %}{% endfor %}{% endif %}</div></section>{% endfor %}
<section class="psc-guide-section-{{ ai_gen_id }}"><div class="psc-guide-inner-{{ ai_gen_id }} psc-guide-contact-{{ ai_gen_id }}">{% if block.settings.logo %}<img class="psc-guide-logo-{{ ai_gen_id }}" src="{{ block.settings.logo | image_url: width: 600 }}" alt="{{ shop.name | escape }}">{% endif %}<h2 class="psc-guide-section-title-{{ ai_gen_id }}">{{ block.settings.contact_title }}</h2><div class="psc-guide-contact-subheading-{{ ai_gen_id }}">{{ block.settings.contact_subheading }}</div><div class="psc-guide-richtext-{{ ai_gen_id }}">{{ block.settings.contact_details }}</div><div class="psc-guide-website-{{ ai_gen_id }}">{{ block.settings.website }}</div></div></section>
</div>
{% schema %}{"name":"PSC installation guide","tag":null,"class":"psc-installation-guide-block","settings":[{"type":"header","content":"Brand and layout"},{"type":"image_picker","id":"logo","label":"PSC logo"},{"type":"image_picker","id":"kit_image","label":"Kit image"},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"sans-serif"},{"type":"font_picker","id":"body_font","label":"Body font","default":"sans-serif"},{"type":"range","id":"logo_width","label":"Logo width","min":80,"max":300,"step":10,"unit":"px","default":140},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"header","content":"Cover page"},{"type":"text","id":"guide_category","label":"Guide category","default":"Technical installation guide"},{"type":"text","id":"product_title","label":"Product title","default":"Accessory Drive Conversion Kit"},{"type":"text","id":"product_application","label":"Product application","default":"GM Gen 5 LT Engine"},{"type":"text","id":"product_year","label":"Product year","default":"2014+"},{"type":"richtext","id":"part_numbers","label":"Part numbers","default":"<p>Part # 12345</p><p>Part # 67890</p>"},{"type":"text","id":"cover_label","label":"Cover label","default":"INSTALLATION GUIDE"},{"type":"header","content":"Table of contents"},{"type":"text","id":"toc_title","label":"TOC heading","default":"TABLE OF CONTENTS"},{"type":"text","id":"toc_1_title","label":"Entry 1","default":"Before you get started"},{"type":"text","id":"toc_1_range","label":"Range 1","default":"03–04"},{"type":"richtext","id":"toc_1_items","label":"Sub-items 1","default":"<ul><li>Tools and safety</li></ul>"},{"type":"text","id":"toc_2_title","label":"Entry 2","default":"What's in the kit"},{"type":"text","id":"toc_2_range","label":"Range 2","default":"05–06"},{"type":"richtext","id":"toc_2_items","label":"Sub-items 2","default":"<ul><li>Included components</li></ul>"},{"type":"text","id":"toc_3_title","label":"Entry 3","default":"Installation"},{"type":"text","id":"toc_3_range","label":"Range 3","default":"07–12"},{"type":"richtext","id":"toc_3_items","label":"Sub-items 3","default":"<ul><li>Step-by-step procedure</li></ul>"},{"type":"text","id":"toc_4_title","label":"Entry 4","default":"Contact us"},{"type":"text","id":"toc_4_range","label":"Range 4","default":"13"},{"type":"richtext","id":"toc_4_items","label":"Sub-items 4","default":"<ul><li>Technical support</li></ul>"},{"type":"header","content":"Guide content"},{"type":"text","id":"before_title","label":"Before title","default":"BEFORE YOU GET STARTED"},{"type":"richtext","id":"before_body","label":"Before body","default":"<p>Review all instructions before beginning. <a href=\"/pages/contact\">Contact technical support</a> with questions.</p>"},{"type":"text","id":"kit_title","label":"Kit title","default":"WHAT'S IN THE KIT"},{"type":"text","id":"kit_1_header","label":"Kit category 1","default":"Conversion components"},{"type":"richtext","id":"kit_1_body","label":"Kit list 1","default":"<ul><li>Part #12345 — Conversion bracket</li></ul>"},{"type":"text","id":"kit_2_header","label":"Kit category 2","default":"Hardware"},{"type":"richtext","id":"kit_2_body","label":"Kit list 2","default":"<ul><li>Part #67890 — Mounting hardware</li></ul>"},{"type":"text","id":"kit_3_header","label":"Kit category 3","default":"Documentation"},{"type":"richtext","id":"kit_3_body","label":"Kit list 3","default":"<ul><li>Installation instructions</li></ul>"},{"type":"text","id":"install_title","label":"Installation title","default":"INSTALLATION"},{"type":"header","content":"Step 1"},{"type":"checkbox","id":"step_1_enabled","label":"Show step 1","default":true},{"type":"text","id":"step_1_header","label":"Header 1","default":"STEP 01"},{"type":"text","id":"step_1_label","label":"Label 1","default":"Prepare the vehicle"},{"type":"richtext","id":"step_1_body","label":"Instructions 1","default":"<ul><li>Disconnect the battery and secure the vehicle.</li></ul>"},{"type":"image_picker","id":"step_1_image","label":"Photo 1"},{"type":"header","content":"Step 2"},{"type":"checkbox","id":"step_2_enabled","label":"Show step 2","default":true},{"type":"text","id":"step_2_header","label":"Header 2","default":"STEP 02"},{"type":"text","id":"step_2_label","label":"Label 2","default":"Remove existing components"},{"type":"richtext","id":"step_2_body","label":"Instructions 2","default":"<ul><li>Remove original components.</li></ul>"},{"type":"image_picker","id":"step_2_image","label":"Photo 2"},{"type":"header","content":"Step 3"},{"type":"checkbox","id":"step_3_enabled","label":"Show step 3","default":true},{"type":"text","id":"step_3_header","label":"Header 3","default":"STEP 03"},{"type":"text","id":"step_3_label","label":"Label 3","default":"Install the kit"},{"type":"richtext","id":"step_3_body","label":"Instructions 3","default":"<ul><li>Position the kit and tighten hardware.</li></ul>"},{"type":"image_picker","id":"step_3_image","label":"Photo 3"},{"type":"header","content":"Step 4"},{"type":"checkbox","id":"step_4_enabled","label":"Show step 4","default":true},{"type":"text","id":"step_4_header","label":"Header 4","default":"STEP 04"},{"type":"text","id":"step_4_label","label":"Label 4","default":"Inspect and test"},{"type":"richtext","id":"step_4_body","label":"Instructions 4","default":"<ul><li>Inspect connections and complete a careful test.</li></ul>"},{"type":"image_picker","id":"step_4_image","label":"Photo 4"},{"type":"header","content":"Contact"},{"type":"text","id":"contact_title","label":"Contact heading","default":"CONTACT US"},{"type":"text","id":"contact_subheading","label":"Contact subheading","default":"Need help with your installation?"},{"type":"richtext","id":"contact_details","label":"Phone, hours and email","default":"<p>Phone: 1-800-555-0199<br>Hours: Monday–Friday, 8 AM–5 PM CDT<br>Email: support@example.com</p>"},{"type":"text","id":"website","label":"Website","default":"www.pscsteering.com"}],"presets":[{"name":"PSC installation guide"}]}{% endschema %}