{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; margin:0 auto; color:{{ block.settings.text_color }}; background:{{ block.settings.background_color }}; }
  .ai-editorial-{{ ai_gen_id }}__inner { padding:clamp(24px,5vw,64px); }
  .ai-editorial-{{ ai_gen_id }}__eyebrow { margin:0 0 12px; color:{{ block.settings.accent_color }}; font-size:12px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; }
  .ai-editorial-{{ ai_gen_id }}__title { max-width:900px; margin:0; font-size:clamp(36px,7vw,{{ block.settings.title_size }}px); line-height:.98; letter-spacing:-.035em; }
  .ai-editorial-{{ ai_gen_id }}__lead { max-width:680px; margin-top:18px; font-size:clamp(18px,2.2vw,24px); line-height:1.4; }
  .ai-editorial-{{ ai_gen_id }}__lead p { margin:0; }
  .ai-editorial-{{ ai_gen_id }}__grid { display:grid; grid-template-columns:minmax(0,1.65fr) minmax(220px,.8fr); gap:clamp(24px,4vw,56px); align-items:start; margin-top:36px; }
  .ai-editorial-{{ ai_gen_id }}__feature { min-width:0; }
  .ai-editorial-{{ ai_gen_id }}__image { display:block; width:100%; height:auto; aspect-ratio:16/10; object-fit:cover; }
  .ai-editorial-{{ ai_gen_id }}__placeholder { position:relative; display:flex; aspect-ratio:16/10; align-items:center; justify-content:center; overflow:hidden; background:#e7e7e7; }
  .ai-editorial-{{ ai_gen_id }}__placeholder svg { display:block; width:100%; height:100%; }
  .ai-editorial-{{ ai_gen_id }}__empty { position:absolute; bottom:12px; left:12px; padding:7px 10px; color:#121212; background:#fff; font-size:13px; }
  .ai-editorial-{{ ai_gen_id }}__caption { margin:10px 0 0; color:{{ block.settings.muted_color }}; font-size:13px; line-height:1.4; }
  .ai-editorial-{{ ai_gen_id }}__story-title { margin:14px 0 8px; font-size:clamp(24px,3vw,36px); line-height:1.05; }
  .ai-editorial-{{ ai_gen_id }}__story-title a,.ai-editorial-{{ ai_gen_id }}__side-title a { color:inherit; text-decoration:none; }
  .ai-editorial-{{ ai_gen_id }}__story-title a:hover,.ai-editorial-{{ ai_gen_id }}__side-title a:hover { text-decoration:underline; text-underline-offset:4px; }
  .ai-editorial-{{ ai_gen_id }}__excerpt { font-size:16px; line-height:1.55; }
  .ai-editorial-{{ ai_gen_id }}__excerpt p { margin:0; }
  .ai-editorial-{{ ai_gen_id }}__side { border-top:2px solid {{ block.settings.accent_color }}; }
  .ai-editorial-{{ ai_gen_id }}__side-label { margin:15px 0 4px; color:{{ block.settings.accent_color }}; font-size:11px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; }
  .ai-editorial-{{ ai_gen_id }}__side-title { margin:0 0 8px; font-size:clamp(20px,2.3vw,28px); line-height:1.1; }
  .ai-editorial-{{ ai_gen_id }}__side-copy { margin:0 0 22px; color:{{ block.settings.muted_color }}; font-size:15px; line-height:1.5; }
  .ai-editorial-{{ ai_gen_id }}__rule { height:1px; border:0; margin:0; background:{{ block.settings.rule_color }}; }
  .ai-editorial-{{ ai_gen_id }}__link { display:inline-block; margin-top:14px; color:{{ block.settings.text_color }}; font-size:14px; font-weight:700; text-decoration:underline; text-underline-offset:4px; }
  .ai-editorial-{{ ai_gen_id }}__link:focus-visible,.ai-editorial-{{ ai_gen_id }}__story-title a:focus-visible,.ai-editorial-{{ ai_gen_id }}__side-title a:focus-visible { outline:2px solid {{ block.settings.accent_color }}; outline-offset:4px; }
  @media screen and (max-width:749px) { .ai-editorial-{{ ai_gen_id }} { width:100%; } .ai-editorial-{{ ai_gen_id }}__inner { padding:28px 20px; } .ai-editorial-{{ ai_gen_id }}__grid { grid-template-columns:1fr; gap:30px; margin-top:26px; } }
{% endstyle %}

<div class="ai-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-{{ ai_gen_id }}__inner">
    {% if block.settings.kicker != blank %}<p class="ai-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings.kicker | escape }}</p>{% endif %}
    {% if block.settings.heading != blank %}<h2 class="ai-editorial-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>{% endif %}
    {% if block.settings.intro != blank %}<div class="ai-editorial-{{ ai_gen_id }}__lead">{{ block.settings.intro }}</div>{% endif %}
    <div class="ai-editorial-{{ ai_gen_id }}__grid">
      <article class="ai-editorial-{{ ai_gen_id }}__feature">
        {% if block.settings.feature_image != blank %}<img class="ai-editorial-{{ ai_gen_id }}__image" src="{{ block.settings.feature_image | image_url: width: 1800 }}" alt="{{ block.settings.feature_image.alt | escape }}" loading="lazy" width="{{ block.settings.feature_image.width }}" height="{{ block.settings.feature_image.height }}">{% else %}<div class="ai-editorial-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<span class="ai-editorial-{{ ai_gen_id }}__empty">Add a lead editorial image</span></div>{% endif %}
        {% if block.settings.caption != blank %}<p class="ai-editorial-{{ ai_gen_id }}__caption">{{ block.settings.caption | escape }}</p>{% endif %}
        {% if block.settings.feature_title != blank %}<h3 class="ai-editorial-{{ ai_gen_id }}__story-title">{% if block.settings.feature_link != blank %}<a href="{{ block.settings.feature_link }}">{{ block.settings.feature_title | escape }}</a>{% else %}{{ block.settings.feature_title | escape }}{% endif %}</h3>{% endif %}
        {% if block.settings.feature_copy != blank %}<div class="ai-editorial-{{ ai_gen_id }}__excerpt">{{ block.settings.feature_copy }}</div>{% endif %}
        {% if block.settings.feature_link != blank and block.settings.feature_link_label != blank %}<a class="ai-editorial-{{ ai_gen_id }}__link" href="{{ block.settings.feature_link }}">{{ block.settings.feature_link_label | escape }}</a>{% endif %}
      </article>
      <aside class="ai-editorial-{{ ai_gen_id }}__side" aria-label="More stories">
        {% if block.settings.side_kicker != blank %}<p class="ai-editorial-{{ ai_gen_id }}__side-label">{{ block.settings.side_kicker | escape }}</p>{% endif %}
        {% if block.settings.side_title != blank %}<h3 class="ai-editorial-{{ ai_gen_id }}__side-title">{% if block.settings.side_link != blank %}<a href="{{ block.settings.side_link }}">{{ block.settings.side_title | escape }}</a>{% else %}{{ block.settings.side_title | escape }}{% endif %}</h3>{% endif %}
        {% if block.settings.side_copy != blank %}<p class="ai-editorial-{{ ai_gen_id }}__side-copy">{{ block.settings.side_copy | escape }}</p>{% endif %}
        <hr class="ai-editorial-{{ ai_gen_id }}__rule">
        {% if block.settings.second_kicker != blank %}<p class="ai-editorial-{{ ai_gen_id }}__side-label">{{ block.settings.second_kicker | escape }}</p>{% endif %}
        {% if block.settings.second_title != blank %}<h3 class="ai-editorial-{{ ai_gen_id }}__side-title">{% if block.settings.second_link != blank %}<a href="{{ block.settings.second_link }}">{{ block.settings.second_title | escape }}</a>{% else %}{{ block.settings.second_title | escape }}{% endif %}</h3>{% endif %}
        {% if block.settings.second_copy != blank %}<p class="ai-editorial-{{ ai_gen_id }}__side-copy">{{ block.settings.second_copy | escape }}</p>{% endif %}
      </aside>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial layout",
  "settings": [
    { "type": "header", "content": "Masthead" },
    { "type": "text", "id": "kicker", "label": "Section label", "default": "Field notes · Issue 01" },
    { "type": "text", "id": "heading", "label": "Main heading", "default": "Built for the road less traveled" },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Engineering insights, product stories, and practical knowledge from the world of performance steering.</p>" },
    { "type": "range", "id": "title_size", "label": "Heading size", "min": 40, "max": 80, "step": 5, "unit": "px", "default": 65 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Lead story" },
    { "type": "image_picker", "id": "feature_image", "label": "Lead image" },
    { "type": "text", "id": "caption", "label": "Image caption" },
    { "type": "text", "id": "feature_title", "label": "Story title", "default": "Precision steering starts with the right foundation" },
    { "type": "richtext", "id": "feature_copy", "label": "Story copy", "default": "<p>Explore the details behind dependable control, carefully engineered components, and a setup built to perform when the terrain gets demanding.</p>" },
    { "type": "url", "id": "feature_link", "label": "Story link" },
    { "type": "text", "id": "feature_link_label", "label": "Link label", "default": "Read the story" },
    { "type": "header", "content": "Related stories" },
    { "type": "text", "id": "side_kicker", "label": "First label", "default": "Workshop" },
    { "type": "text", "id": "side_title", "label": "First title", "default": "What to consider when upgrading your steering system" },
    { "type": "textarea", "id": "side_copy", "label": "First summary", "default": "A practical look at fitment, intended use, and the components that work together." },
    { "type": "url", "id": "side_link", "label": "First link" },
    { "type": "text", "id": "second_kicker", "label": "Second label", "default": "Product insight" },
    { "type": "text", "id": "second_title", "label": "Second title", "default": "Designed for confidence under load" },
    { "type": "textarea", "id": "second_copy", "label": "Second summary", "default": "Learn how thoughtful component choices can support a responsive, reliable build." },
    { "type": "url", "id": "second_link", "label": "Second link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" },
    { "type": "color", "id": "muted_color", "label": "Secondary text", "default": "#575757" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#D6001C" },
    { "type": "color", "id": "rule_color", "label": "Divider", "default": "#D1D1D1" }
  ],
  "presets": [{ "name": "Editorial layout" }],
  "tag": null,
  "class": "editorial-layout"
}
{% endschema %}