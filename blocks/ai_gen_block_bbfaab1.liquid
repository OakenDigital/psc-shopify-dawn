{% doc %}
  @prompt
    Create a NEW replacement Install guide table for PSC Motorsports on the currently selected psc-install-guides template. Keep the existing table untouched so the merchant can compare and remove it later. Build exactly 5 columns and 21 body rows plus a separate header row. Make all five headings editable. Columns 1–4 must have separately editable text cells for every row. Column 5 must display a shared image chosen through ONE image-picker setting labeled 'Download image', intended for the existing Shopify Files image named 'Download'. If the actual image can be resolved, select it; otherwise leave the picker unset for the merchant to select it, never invent a URL. Provide 21 individually editable URL settings clearly labeled 'Row 1 PDF link' through 'Row 21 PDF link'. Each row's column 5 image must link ONLY to that row's URL. Leave URL fields empty initially. When a URL is blank, render that row's image without a link. Give linked images accessible text describing the row's download, with an editable fallback label. Provide an editable shared image width setting. Match current theme styling, with readable cell padding, clear headers, subtle row borders, and horizontal scrolling confined to the table on mobile. Do not invent guide content or links. Do not change the About Us page content or template assignment; it is only the preview resource for psc-install-guides. Ensure the shared image picker and all 21 per-row URL controls are present and wired to the rendered fifth-column cells.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-install-table-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;color:rgb(var(--color-foreground));font-family:var(--font-body-family)}
.ai-install-table__scroll-{{ ai_gen_id }}{width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}
.ai-install-table__table-{{ ai_gen_id }}{width:100%;min-width:760px;border-collapse:collapse;text-align:left}
.ai-install-table__table-{{ ai_gen_id }} th,.ai-install-table__table-{{ ai_gen_id }} td{padding:12px 14px;border-bottom:1px solid rgba(var(--color-foreground),.18);vertical-align:middle}
.ai-install-table__table-{{ ai_gen_id }} th{font-weight:700;background:rgba(var(--color-foreground),.06)}
.ai-install-table__image-{{ ai_gen_id }}{display:block;width:{{ block.settings.image_width }}px;max-width:100%;height:auto}
{% endstyle %}
{% capture image_class %}ai-install-table__image-{{ ai_gen_id }}{% endcapture %}
<div class="ai-install-table-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-install-table__scroll-{{ ai_gen_id }}" role="region" aria-label="Install guide table" tabindex="0"><table class="ai-install-table__table-{{ ai_gen_id }}"><thead><tr>{% for i in (1..5) %}{% assign heading_key = 'heading_' | append: i %}<th scope="col">{{ block.settings[heading_key] | escape }}</th>{% endfor %}</tr></thead><tbody>
{% for i in (1..21) %}{% assign row_link_key = 'row_' | append: i | append: '_pdf_link' %}{% assign first_cell_key = 'row_' | append: i | append: '_col_1' %}<tr>{% for col in (1..4) %}{% assign cell_key = 'row_' | append: i | append: '_col_' | append: col %}<td>{{ block.settings[cell_key] | escape }}</td>{% endfor %}<td>{% if block.settings.download_image != blank %}{% if block.settings[row_link_key] != blank %}<a href="{{ block.settings[row_link_key] }}" aria-label="{{ block.settings.row_download_label | escape }} — {{ block.settings[first_cell_key] | escape }}">{% endif %}{{ block.settings.download_image | image_url: width: 600 | image_tag: class: image_class, alt: block.settings.row_download_label, loading: 'lazy' }}{% if block.settings[row_link_key] != blank %}</a>{% endif %}{% endif %}</td></tr>{% endfor %}
</tbody></table></div></div>
