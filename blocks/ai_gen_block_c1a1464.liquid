{% doc %}
  @prompt
    Create an installation guide page template for PSC Motorsports (automotive performance steering parts brand) that closely matches their existing PDF guide layout. The template should include:
    
    COVER SECTION: A category label in small caps above the title (e.g. "Accessory Drive Conversion Kits"), a large bold red product title, a list of compatible part numbers with red square bullet markers, a featured product image in a rounded-corner bordered box, and a bold "Installation Guide" label at the bottom.
    
    INTERIOR PAGE HEADER: A decorative diagonal stripe band (black fading to gray) across the top of interior sections, with the PSC logo centered below it.
    
    TABLE OF CONTENTS SECTION: A bold centered "Table of Contents" heading, with entries that have gray pill/tab-style section labels showing page numbers, followed by bulleted sub-items beneath each entry.
    
    BEFORE YOU GET STARTED SECTION: Same diagonal stripe header, centered bold section title, body text paragraphs with support for inline red-colored hyperlinks for part numbers.
    
    WHAT'S IN THE KIT SECTION: Grouped parts list with gray banner-style category headers (e.g. "Brackets", "Components", "Power Steering Pump"), each followed by bulleted part entries showing part number and description.
    
    STEP-BY-STEP INSTALLATION SECTION: Two-column layout — left column has a gray pill-style numbered step header (e.g. "1. Prep the Engine"), bold sub-labels, and bullet point instructions; right column shows a step photo with a circled step number overlaid in the top-left corner.
    
    DESIGN DETAILS: Primary accent color red (#CC0000), gray pill/tab headers, bold condensed sans-serif typography, clean white background, PSC logo on each interior section. All text content and images must be editable in the Shopify theme editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-guide-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:auto;background:#fff;color:#171717;font-family:{{ block.settings.body_font.family }},sans-serif;line-height:1.55}.ai-guide-{{ ai_gen_id }} h1,.ai-guide-{{ ai_gen_id }} h2,.ai-guide-{{ ai_gen_id }} strong{font-family:{{ block.settings.heading_font.family }},sans-serif;font-weight:800}.ai-guide-cover-{{ ai_gen_id }}{padding:clamp(28px,6vw,84px);min-height:620px;display:flex;flex-direction:column;justify-content:space-between}.ai-guide-kicker-{{ ai_gen_id }}{font-size:13px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#555}.ai-guide-title-{{ ai_gen_id }}{color:#c00;font-size:clamp(36px,6vw,76px);line-height:.98}.ai-guide-parts-{{ ai_gen_id }}{list-style:none;padding:0}.ai-guide-parts-{{ ai_gen_id }} li:before{content:'';display:inline-block;width:9px;height:9px;background:#c00;margin-right:10px}.ai-guide-feature-{{ ai_gen_id }},.ai-guide-photo-{{ ai_gen_id }}{border:1px solid #bbb;border-radius:14px;padding:10px}.ai-guide-feature-{{ ai_gen_id }} img,.ai-guide-photo-{{ ai_gen_id }} img{width:100%;display:block;border-radius:8px}.ai-guide-placeholder-{{ ai_gen_id }}{min-height:240px;background:#f3f3f3;display:flex;align-items:center;justify-content:center}.ai-guide-placeholder-{{ ai_gen_id }} svg{width:100%;max-height:300px}.ai-guide-page-{{ ai_gen_id }}{padding:0 clamp(24px,6vw,84px) 70px}.ai-guide-stripes-{{ ai_gen_id }}{height:54px;margin:0 calc(clamp(24px,6vw,84px)*-1) 20px;background:repeating-linear-gradient(135deg,#171717 0 18px,#777 18px 36px)}.ai-guide-logo-{{ ai_gen_id }}{display:block;width:{{ block.settings.logo_width }}px;max-width:55%;margin:0 auto 34px}.ai-guide-heading-{{ ai_gen_id }}{text-align:center;font-size:clamp(28px,4vw,46px)}.ai-guide-pill-{{ ai_gen_id }},.ai-guide-step-head-{{ ai_gen_id }}{display:flex;justify-content:space-between;background:#e7e7e7;border-radius:999px;padding:9px 17px;font-weight:800}.ai-guide-banner-{{ ai_gen_id }}{background:#686868;color:#fff;padding:8px 16px;text-transform:uppercase}.ai-guide-columns-{{ ai_gen_id }}{display:grid;grid-template-columns:1fr 1fr;gap:42px}.ai-guide-photo-{{ ai_gen_id }}{position:relative}.ai-guide-photo-number-{{ ai_gen_id }}{position:absolute;top:20px;left:20px;background:#c00;color:#fff;border-radius:50%;width:42px;height:42px;display:flex;align-items:center;justify-content:center;font-weight:800}.ai-guide-richtext-{{ ai_gen_id }} a{color:#c00;font-weight:700}@media(max-width:749px){.ai-guide-columns-{{ ai_gen_id }}{grid-template-columns:1fr}}
{% endstyle %}
<div class="ai-guide-{{ ai_gen_id }}" {{ block.shopify_attributes }}><section class="ai-guide-cover-{{ ai_gen_id }}"><div><p class="ai-guide-kicker-{{ ai_gen_id }}">{{ block.settings.category_label }}</p><h1 class="ai-guide-title-{{ ai_gen_id }}">{{ block.settings.product_title }}</h1><ul class="ai-guide-parts-{{ ai_gen_id }}">{% assign parts=block.settings.compatible_parts | newline_to_br | split:'<br />' %}{% for part in parts %}{% if part != blank %}<li>{{ part }}</li>{% endif %}{% endfor %}</ul><div class="ai-guide-feature-{{ ai_gen_id }}">{% if block.settings.featured_image %}<img src="{{ block.settings.featured_image | image_url: width:1400 }}" alt="{{ block.settings.featured_image.alt | escape }}">{% else %}<div class="ai-guide-placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</div></div><strong>{{ block.settings.installation_label }}</strong></section>{% assign titles=block.settings.toc_titles | newline_to_br | split:'<br />' %}{% assign pages=block.settings.toc_pages | newline_to_br | split:'<br />' %}{% assign items=block.settings.toc_items | newline_to_br | split:'<br />' %}<section class="ai-guide-page-{{ ai_gen_id }}"><div class="ai-guide-stripes-{{ ai_gen_id }}"></div>{% if block.settings.logo %}<img class="ai-guide-logo-{{ ai_gen_id }}" src="{{ block.settings.logo | image_url: width:500 }}" alt="PSC Motorsports">{% endif %}<h2 class="ai-guide-heading-{{ ai_gen_id }}">{{ block.settings.toc_heading }}</h2>{% for title in titles %}{% if title != blank %}<div class="ai-guide-pill-{{ ai_gen_id }}"><span>{{ title }}</span><span>{{ pages[forloop.index0] }}</span></div><ul>{% assign line=items[forloop.index0] | split:'|' %}{% for item in line %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}{% endfor %}</section><section class="ai-guide-page-{{ ai_gen_id }}"><div class="ai-guide-stripes-{{ ai_gen_id }}"></div>{% if block.settings.logo %}<img class="ai-guide-logo-{{ ai_gen_id }}" src="{{ block.settings.logo | image_url: width:500 }}" alt="PSC Motorsports">{% endif %}<h2 class="ai-guide-heading-{{ ai_gen_id }}">{{ block.settings.before_heading }}</h2><div class="ai-guide-richtext-{{ ai_gen_id }}">{{ block.settings.before_text }}</div><h2 class="ai-guide-heading-{{ ai_gen_id }}">{{ block.settings.kit_heading }}</h2>{% assign cats=block.settings.kit_categories | newline_to_br | split:'<br />' %}{% assign kit=block.settings.kit_parts | newline_to_br | split:'<br />' %}{% for cat in cats %}<div class="ai-guide-banner-{{ ai_gen_id }}">{{ cat }}</div><ul>{% assign line=kit[forloop.index0] | split:'|' %}{% for item in line %}<li>{{ item }}</li>{% endfor %}</ul>{% endfor %}</section><section class="ai-guide-page-{{ ai_gen_id }}"><div class="ai-guide-stripes-{{ ai_gen_id }}"></div><h2 class="ai-guide-heading-{{ ai_gen_id }}">{{ block.settings.steps_heading }}</h2>{% for i in (1..4) %}{% case i %}{% when 1 %}{% assign title=block.settings.step_1_title %}{% assign text=block.settings.step_1_text %}{% assign image=block.settings.step_1_image %}{% when 2 %}{% assign title=block.settings.step_2_title %}{% assign text=block.settings.step_2_text %}{% assign image=block.settings.step_2_image %}{% when 3 %}{% assign title=block.settings.step_3_title %}{% assign text=block.settings.step_3_text %}{% assign image=block.settings.step_3_image %}{% when 4 %}{% assign title=block.settings.step_4_title %}{% assign text=block.settings.step_4_text %}{% assign image=block.settings.step_4_image %}{% endcase %}{% if title != blank %}<div class="ai-guide-columns-{{ ai_gen_id }}"><div><div class="ai-guide-step-head-{{ ai_gen_id }}"><span>{{ i }}</span><strong>{{ title }}</strong></div><div class="ai-guide-richtext-{{ ai_gen_id }}">{{ text }}</div></div><div class="ai-guide-photo-{{ ai_gen_id }}"><span class="ai-guide-photo-number-{{ ai_gen_id }}">{{ i }}</span>{% if image %}<img src="{{ image | image_url: width:1000 }}" alt="{{ image.alt | escape }}">{% else %}<div class="ai-guide-placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</div></div>{% endif %}{% endfor %}</section></div>
{% schema %}{"name":"Installation guide","tag":null,"class":"psc-installation-guide","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"system_ui_n4"},{"type":"font_picker","id":"body_font","label":"Body font","default":"system_ui_n4"},{"type":"image_picker","id":"logo","label":"PSC logo"},{"type":"range","id":"logo_width","label":"Logo width","min":80,"max":280,"step":10,"unit":"px","default":140},{"type":"text","id":"category_label","label":"Category label","default":"Accessory Drive Conversion Kits"},{"type":"text","id":"product_title","label":"Product title","default":"PSC Motorsports Installation Guide"},{"type":"textarea","id":"compatible_parts","label":"Compatible part numbers","default":"Part number 1\nPart number 2"},{"type":"image_picker","id":"featured_image","label":"Featured image"},{"type":"text","id":"installation_label","label":"Installation label","default":"Installation Guide"},{"type":"text","id":"toc_heading","label":"Contents heading","default":"Table of Contents"},{"type":"textarea","id":"toc_titles","label":"Section labels","default":"Before You Get Started\nWhat's in the Kit\nInstallation"},{"type":"textarea","id":"toc_pages","label":"Page numbers","default":"2\n3\n4"},{"type":"textarea","id":"toc_items","label":"Sub-items","default":"Safety|Tools\nBrackets|Components|Pump\nPrep|Install|Checks"},{"type":"text","id":"before_heading","label":"Before heading","default":"Before You Get Started"},{"type":"richtext","id":"before_text","label":"Before text","default":"<p>Read all instructions before beginning. Contact support for <a href=\"#\">part numbers</a>.</p>"},{"type":"text","id":"kit_heading","label":"Kit heading","default":"What's in the Kit"},{"type":"textarea","id":"kit_categories","label":"Kit categories","default":"Brackets\nComponents\nPower Steering Pump"},{"type":"textarea","id":"kit_parts","label":"Kit parts","default":"BRK-001 — Main bracket|BRK-002 — Support bracket\nCMP-001 — Hardware|CMP-002 — Hoses\nPMP-001 — Performance pump"},{"type":"text","id":"steps_heading","label":"Steps heading","default":"Step-by-Step Installation"},{"type":"text","id":"step_1_title","label":"Step 1 title","default":"Prep the Engine"},{"type":"richtext","id":"step_1_text","label":"Step 1 instructions","default":"<p><strong>Prepare safely.</strong></p><ul><li>Disconnect power.</li><li>Clean the mounting surface.</li></ul>"},{"type":"image_picker","id":"step_1_image","label":"Step 1 photo"},{"type":"text","id":"step_2_title","label":"Step 2 title","default":"Install the Brackets"},{"type":"richtext","id":"step_2_text","label":"Step 2 instructions","default":"<p>Align and torque the brackets.</p>"},{"type":"image_picker","id":"step_2_image","label":"Step 2 photo"},{"type":"text","id":"step_3_title","label":"Step 3 title","default":"Install Components"},{"type":"richtext","id":"step_3_text","label":"Step 3 instructions","default":"<p>Route hoses away from heat and moving parts.</p>"},{"type":"image_picker","id":"step_3_image","label":"Step 3 photo"},{"type":"text","id":"step_4_title","label":"Step 4 title","default":"Final Checks"},{"type":"richtext","id":"step_4_text","label":"Step 4 instructions","default":"<p>Fill, bleed, and check for leaks.</p>"},{"type":"image_picker","id":"step_4_image","label":"Step 4 photo"}],"presets":[{"name":"Installation guide"}]}{% endschema %}