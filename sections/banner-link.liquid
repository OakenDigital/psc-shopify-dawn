{%- comment -%}
  Banner Link Section
  Renders a full-width image banner where the entire element acts as a link.
{%- endcomment -%}

<div class="banner-link-section section-{{ section.id }}-padding">
  {%- if section.settings.link != blank -%}
    <a href="{{ section.settings.link }}" class="banner-link" aria-label="{{ section.settings.alt_text | default: 'Banner link' | escape }}">
  {%- else -%}
    <div class="banner-link banner-link--no-link">
  {%- endif -%}

    <div class="banner-link__media">
      {%- if section.settings.image != blank -%}
        <img 
          src="{{ section.settings.image | image_url: width: 2000 }}"
          srcset="{{ section.settings.image | image_url: width: 550 }} 550w,
                  {{ section.settings.image | image_url: width: 750 }} 750w,
                  {{ section.settings.image | image_url: width: 1100 }} 1100w,
                  {{ section.settings.image | image_url: width: 1500 }} 1500w,
                  {{ section.settings.image | image_url: width: 2000 }} 2000w"
          sizes="100vw"
          alt="{{ section.settings.alt_text | default: section.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          class="banner-link__image"
        >
      {%- else -%}
        <div class="banner-link__placeholder-wrapper">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'banner-link__placeholder' }}
        </div>
      {%- endif -%}
    </div>

  {%- if section.settings.link != blank -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}
</div>

<style>
  .banner-link-section {
    width: 100%;
  }

  .banner-link {
    display: block;
    position: relative;
    width: 100%;
    text-decoration: none;
    line-height: 0;
  }

  .banner-link__media {
    position: relative;
    width: 100%;
  }

  .banner-link__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .banner-link__placeholder-wrapper {
    width: 100%;
    background-color: #f3f3f3;
  }

  .banner-link__placeholder {
    width: 100%;
    height: 100%;
    min-height: 400px;
    object-fit: cover;
  }

  /* Dynamic vertical padding from schema settings */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

{% schema %}
{
  "name": "Clickable Banner",
  "tag": "section",
  "class": "section-clickable-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Banner Link"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Image Alt Text",
      "info": "Important for accessibility and SEO. Leave blank to use the image default."
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Clickable Banner"
    }
  ]
}
{% endschema %}