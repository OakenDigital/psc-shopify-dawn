{% comment %}
  Dynamic Landing Page Builder Section with Step-by-Step Selection & Filtering
{% endcomment %}

{{ 'landing-page-builder.css' | asset_url | stylesheet_tag }}

<div class="lp-container" id="dds-interactive-builder">
  {% for block in section.blocks %}
    {% case block.type %}

      {% comment %} --- SECTION 1: HERO --- {% endcomment %}
      {% when 'hero' %}
        <div class="lp-section lp-hero" {{ block.shopify_attributes }}>
          <div class="lp-hero-content">
            <h1>{{ block.settings.headline }}</h1>
            <p class="lp-subheadline">{{ block.settings.subheadline }}</p>
            <div class="lp-btn-group">
              {% if block.settings.btn1_text != blank %}
                <a href="{{ block.settings.btn1_link }}" class="lp-btn lp-btn-primary">{{ block.settings.btn1_text }}</a>
              {% endif %}
              {% if block.settings.btn2_text != blank %}
                <a href="{{ block.settings.btn2_link }}" class="lp-btn lp-btn-secondary">{{ block.settings.btn2_text }}</a>
              {% endif %}
            </div>
          </div>
        </div>

      {% comment %} --- SECTION 2: FEATURE / INFO --- {% endcomment %}
      {% when 'feature_overview' %}
        <div class="lp-section lp-feature" {{ block.shopify_attributes }}>
          <div class="lp-grid lp-grid-2col">
            <div class="lp-feature-media">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.heading }}" loading="lazy">
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'lp-placeholder' }}
              {% endif %}
            </div>
            <div class="lp-feature-content">
              <h2>{{ block.settings.heading }}</h2>
              <div class="lp-rte">{{ block.settings.copy }}</div>
              {% if block.settings.bullets != blank %}
                <div class="lp-bullets">
                  {{ block.settings.bullets }}
                </div>
              {% endif %}
            </div>
          </div>
        </div>

      {% comment %} --- SECTIONS 3, 4, 5: FILTER SELECTION GRIDS --- {% endcomment %}
      {% when 'filter_step' %}
        <div class="lp-section lp-filter-step" id="{{ block.settings.section_id }}" data-step="{{ block.settings.step_type }}" {{ block.shopify_attributes }}>
          <div class="lp-section-header">
            <h2><span class="lp-step-num">{{ block.settings.step_number }}</span> {{ block.settings.title }}</h2>
            {% if block.settings.subtitle != blank %}
              <p>{{ block.settings.subtitle }}</p>
            {% endif %}
          </div>
          <div class="lp-card-grid lp-grid-cols-{{ block.settings.columns }}">
            {% for i in (1..6) %}
              {% capture title_key %}card_{{ i }}_title{% endcapture %}
              {% capture sub_key %}card_{{ i }}_sub{% endcapture %}
              {% capture val_key %}card_{{ i }}_val{% endcapture %}
              {% capture img_key %}card_{{ i }}_img{% endcapture %}

              {% assign title = block.settings[title_key] %}
              {% assign sub = block.settings[sub_key] %}
              {% assign val = block.settings[val_key] %}
              {% assign img = block.settings[img_key] %}

              {% if title != blank %}
                <button type="button" class="lp-card lp-select-card" data-step="{{ block.settings.step_type }}" data-value="{{ val | downcase | escape }}">
                  {% if img != blank %}
                    <div class="lp-card-img">
                      <img src="{{ img | image_url: width: 400 }}" alt="{{ title }}" loading="lazy">
                    </div>
                  {% endif %}
                  <div class="lp-card-info">
                    <h3>{{ title }}</h3>
                    {% if sub != blank %}<p>{{ sub }}</p>{% endif %}
                  </div>
                </button>
              {% endif %}
            {% endfor %}
          </div>
        </div>

      {% comment %} --- SECTION 6: DYNAMIC RECOMMENDED SYSTEM --- {% endcomment %}
      {% when 'dynamic_system' %}
        <div class="lp-section lp-system-builder" id="recommended-system-section" {{ block.shopify_attributes }}>
          <div class="lp-section-header">
            <h2>{{ block.settings.title }}</h2>
            <p id="lp-system-status">{{ block.settings.default_prompt }}</p>
          </div>

          <div id="lp-recommended-products-wrapper" style="display: none;">
            <div class="lp-grid lp-grid-4col">
              {% for i in (1..4) %}
                {% capture label_key %}label_{{ i }}{% endcapture %}
                {% assign label = block.settings[label_key] %}
                <div class="lp-product-card" id="system-slot-{{ i }}">
                  <span class="lp-card-badge">{{ label }}</span>
                  <img src="" alt="" class="slot-img" loading="lazy">
                  <h4 class="slot-title"></h4>
                  <p class="lp-sku slot-sku"></p>
                  <p class="lp-price slot-price"></p>
                </div>
              {% endfor %}
            </div>
            {% if block.settings.cta_text != blank %}
              <div class="lp-text-center lp-mt-20">
                <a href="#" id="lp-build-bundle-btn" class="lp-btn lp-btn-primary">{{ block.settings.cta_text }}</a>
              </div>
            {% endif %}
          </div>
        </div>

      {% comment %} --- SECTION 7: ADD-ON PRODUCTS GRID --- {% endcomment %}
      {% when 'product_grid' %}
        <div class="lp-section lp-product-grid-section" {{ block.shopify_attributes }}>
          <div class="lp-section-header">
            <h2>{{ block.settings.title }}</h2>
            <p>{{ block.settings.subtitle }}</p>
          </div>
          <div class="lp-grid lp-grid-3col">
            {% for product in block.settings.collection.products limit: block.settings.limit %}
              <div class="lp-product-card">
                <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title }}" loading="lazy">
                <h4>{{ product.title }}</h4>
                <p class="lp-sku">SKU: {{ product.selected_or_first_available_variant.sku }}</p>
                <p class="lp-price">{{ product.price | money }}</p>
                <a href="{{ product.url }}" class="lp-btn lp-btn-secondary lp-btn-sm">View Details</a>
              </div>
            {% endfor %}
          </div>
        </div>

      {% comment %} --- SECTION 8: HOW TO ORDER --- {% endcomment %}
      {% when 'order_guide' %}
        <div class="lp-section lp-order-guide" {{ block.shopify_attributes }}>
          <div class="lp-guide-card">
            <h2>{{ block.settings.title }}</h2>
            <div class="lp-rte">{{ block.settings.checklist }}</div>
            {% if block.settings.contact_info != blank %}
              <div class="lp-guide-footer">
                {{ block.settings.contact_info }}
              </div>
            {% endif %}
          </div>
        </div>

      {% comment %} --- SECTION 9: FAQ BLOCK --- {% endcomment %}
      {% when 'faq_item' %}
        <div class="lp-faq-item" {{ block.shopify_attributes }}>
          <details>
            <summary><strong>{{ block.settings.question }}</strong></summary>
            <div class="lp-faq-answer">
              <p>{{ block.settings.answer }}</p>
            </div>
          </details>
        </div>

    {% endcase %}
  {% endfor %}
</div>

<style>
  .lp-container { 
    max-width: 1200px; 
    margin: 0 auto; 
    padding: 10px 20px; 
    font-family: inherit; 
    color: var(--color-foreground, {{ settings.colors_text | default: 'inherit' }});
  }
  
  /* Reduced vertical spacing */
  .lp-section { margin-bottom: 25px; scroll-margin-top: 30px; }
  
  /* Section Separator Rule */
  .lp-divider {
    border: 0;
    height: 1px;
    background: var(--color-border, {{ settings.colors_borders | default: '#e0e0e0' }});
    margin: 30px 0;
    opacity: 0.6;
  }

  .lp-hero { 
    text-align: center; 
    padding: 40px 20px; 
    background-color: var(--color-background-secondary, {{ settings.colors_background_2 | default: '#f8f9fa' }}); 
    border-radius: 8px; 
  }
  .lp-hero h1 { font-size: 2.2rem; margin-bottom: 10px; }
  .lp-subheadline { 
    font-size: 1.1rem; 
    max-width: 800px; 
    margin: 0 auto 20px; 
    color: var(--color-foreground-75, {{ settings.colors_text | default: '#555' }}); 
  }
  
  .lp-btn-group { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .lp-btn { 
    display: inline-block; 
    padding: 10px 20px; 
    text-decoration: none; 
    border-radius: 4px; 
    font-weight: bold; 
    text-align: center; 
    cursor: pointer; 
    border: none; 
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .lp-btn-primary { 
    background-color: var(--color-button, {{ settings.colors_accent_1 | default: '#d32f2f' }}); 
    color: var(--color-button-text, #ffffff); 
  }
  .lp-btn-secondary { 
    background-color: var(--color-button-secondary, {{ settings.colors_accent_2 | default: '#333333' }}); 
    color: var(--color-button-secondary-text, #ffffff); 
  }
  .lp-btn-sm { padding: 6px 14px; font-size: 0.85rem; margin-top: 8px; }
  
  .lp-step-num { 
    background: var(--color-button, {{ settings.colors_accent_1 | default: '#d32f2f' }}); 
    color: var(--color-button-text, #ffffff); 
    border-radius: 50%; 
    width: 26px; 
    height: 26px; 
    display: inline-flex; 
    align-items: center; 
    justify-content: center; 
    font-size: 0.85rem; 
    margin-right: 8px; 
  }
  
  .lp-grid { display: grid; gap: 15px; }
  .lp-grid-2col { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); align-items: center; }
  .lp-grid-3col { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .lp-grid-4col { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  
  /* Filter Card Grid Base & Mobile Layout */
  .lp-card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  /* Desktop Layout (Single Row) */
  @media (min-width: 769px) {
    .lp-card-grid.lp-grid-cols-2 { grid-template-columns: repeat(2, 1fr); }
    .lp-card-grid.lp-grid-cols-3 { grid-template-columns: repeat(3, 1fr); }
    .lp-card-grid.lp-grid-cols-4 { grid-template-columns: repeat(4, 1fr); }
    .lp-card-grid.lp-grid-cols-5 { grid-template-columns: repeat(5, 1fr); }
    .lp-card-grid.lp-grid-cols-6 { grid-template-columns: repeat(6, 1fr); }
  }

  /* Cards dynamically matching theme borders and accent active states */
  .lp-select-card { 
    background: var(--color-card-background, #ffffff); 
    border: 2px solid var(--color-border, #e0e0e0); 
    border-radius: 6px; 
    padding: 12px; 
    color: inherit; 
    display: flex; 
    flex-direction: column; 
    justify-content: center; 
    align-items: center; 
    width: 100%; 
    text-align: center; 
    transition: all 0.2s ease; 
    cursor: pointer; 
  }
  .lp-select-card:hover { 
    border-color: var(--color-foreground-50, #999999); 
    transform: translateY(-2px); 
  }
  .lp-select-card.active { 
    border-color: var(--color-button, {{ settings.colors_accent_1 | default: '#d32f2f' }}); 
    background-color: var(--color-background-secondary, #fff8f8); 
    box-shadow: 0 0 0 1px var(--color-button, {{ settings.colors_accent_1 | default: '#d32f2f' }}); 
  }
  .lp-card-img img { max-width: 100%; height: auto; max-height: 100px; object-fit: contain; }

  .lp-product-card { 
    border: 1px solid var(--color-border, #e0e0e0); 
    border-radius: 6px; 
    padding: 12px; 
    text-align: center; 
    position: relative; 
    background: var(--color-card-background, #ffffff); 
  }
  .lp-product-card img { max-width: 100%; height: 140px; object-fit: contain; }
  .lp-card-badge { 
    position: absolute; 
    top: 8px; 
    left: 8px; 
    background: var(--color-foreground, #111111); 
    color: var(--color-background, #ffffff); 
    font-size: 0.7rem; 
    padding: 3px 6px; 
    border-radius: 3px; 
  }
  .lp-sku { font-size: 0.8rem; color: var(--color-foreground-75, #666666); margin: 4px 0; }
  .lp-price { 
    font-weight: bold; 
    color: var(--color-button, {{ settings.colors_accent_1 | default: '#d32f2f' }}); 
    margin-top: 4px; 
  }

  .lp-order-guide { 
    background: var(--color-background-secondary, #f4f4f4); 
    padding: 20px 25px; 
    border-radius: 8px; 
    border-left: 5px solid var(--color-button, {{ settings.colors_accent_1 | default: '#d32f2f' }}); 
  }
  .lp-faq-item { 
    border-bottom: 1px solid var(--color-border, #e0e0e0); 
    padding: 10px 0; 
  }
  .lp-faq-item summary { cursor: pointer; font-size: 1rem; }
  .lp-faq-answer { padding-top: 8px; color: var(--color-foreground-75, #444444); }

  .lp-section-header { text-align: center; margin-bottom: 15px; }
  .lp-section-header h2 { margin-bottom: 5px; font-size: 1.6rem; }
  .lp-section-header p { margin: 0; color: var(--color-foreground-75, #666666); }
  .lp-text-center { text-align: center; }
  .lp-mt-20 { margin-top: 15px; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const selections = {
      engine: null,
      axle: null,
      tierod: null
    };

    const cards = document.querySelectorAll('.lp-select-card');
    const statusText = document.getElementById('lp-system-status');
    const wrapper = document.getElementById('lp-recommended-products-wrapper');
    const bundleBtn = document.getElementById('lp-build-bundle-btn');

    cards.forEach(card => {
      card.addEventListener('click', function() {
        const step = this.getAttribute('data-step');
        const val = this.getAttribute('data-value');

        // Toggle active styling within same step group
        document.querySelectorAll(`.lp-select-card[data-step="${step}"]`).forEach(c => c.classList.remove('active'));
        this.classList.add('active');

        selections[step] = val;

        checkSelectionsAndRedirect();
      });
    });

    function checkSelectionsAndRedirect() {
      if (selections.engine && selections.axle && selections.tierod) {
        // Construct the collection handle based on your naming convention
        const collectionHandle = `dds-${selections.engine}-${selections.axle}-${selections.tierod}`;
        const collectionUrl = `/collections/${collectionHandle}`;

        statusText.textContent = 'Configuration complete! Click below to view your custom kit setup.';
        
        if (bundleBtn) {
          bundleBtn.setAttribute('href', collectionUrl);
          bundleBtn.textContent = 'View Matching DDS Collection';
        }
        
        wrapper.style.display = 'block';

        // Optional: Smooth scroll user to Section 6 automatically upon completing selections
        const targetSection = document.getElementById('recommended-system-section');
        if (targetSection) {
          targetSection.scrollIntoView({ behavior: 'smooth' });
        }
      } else {
        const missing = [];
        if (!selections.engine) missing.push('Engine');
        if (!selections.axle) missing.push('Axle');
        if (!selections.tierod) missing.push('Tie Rod');
        
        statusText.textContent = `Please select your ${missing.join(', ')} above to generate your setup.`;
        wrapper.style.display = 'none';
      }
    }
  });
</script>

