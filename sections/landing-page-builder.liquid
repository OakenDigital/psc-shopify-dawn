    list-style: none;
    padding: 0;
    margin: 0 auto 32px;
    display: inline-block;
    text-align: left;
  }
  .section-why-upgrade .pain-points-list li {
    font-size: 1.1rem;
    padding: 8px 0;
    position: relative;
    padding-left: 28px;
  }
  .section-why-upgrade .pain-points-list li::before {
    content: "✕";
    color: #d32f2f;
    position: absolute;
    left: 0;
    font-weight: bold;
  }
  .solution-callout { background: #f8f9fa; padding: 24px; border-radius: 8px; border-left: 4px solid #d32f2f; }

  /* Cards & Grids */
  .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
  .grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; }
  .grid-5 { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; }

  .card {
    background: #f9f9f9;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 20px;
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .card:hover { transform: translateY(-4px); box-shadow: 0 6px 16px rgba(0,0,0,0.1); }
  .card img { width: 100%; height: auto; border-radius: 6px; margin-bottom: 12px; }

  /* System Builder Flow */
  .system-flow {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 500px;
    margin: 30px auto 0;
  }
  .flow-step {
    background: #1a1a1a;
    color: #fff;
    width: 100%;
    padding: 16px;
    text-align: center;
    border-radius: 6px;
  }
  .flow-step h4 { margin: 0; font-size: 1.1rem; }
  .flow-arrow { font-size: 1.8rem; color: #d32f2f; margin: 8px 0; font-weight: bold; }

  /* Contact Section */
  .section-contact { text-align: center; }
  .contact-details { display: flex; justify-content: center; gap: 30px; margin-top: 20px; font-size: 1.2rem; }
  .contact-details a { color: #d32f2f; text-decoration: none; font-weight: bold; }

  @media (max-width: 768px) {
    .section-hero { grid-template-columns: 1fr; text-align: center; }
    .section-hero h2 { text-align: center; }
    .hero-actions { display: flex; flex-direction: column; gap: 10px; }
    .button--secondary { margin-left: 0; }
    .contact-details { flex-direction: column; gap: 10px; }
  }
</style>

<div class="jeep-steering-landing">

  {% for block in section.blocks %}
    {% case block.type %}

      {% when 'hero' %}
        <section class="section-hero" {{ block.shopify_attributes }}>
          <div class="hero-content">
            <h1>{{ block.settings.heading | escape }}</h1>
            <h2>{{ block.settings.subheading | escape }}</h2>
            <p>{{ block.settings.description | escape }}</p>
            <div class="hero-actions">
              {% if block.settings.primary_btn_label != blank %}
                <a href="{{ block.settings.primary_btn_url }}" class="button button--primary">{{ block.settings.primary_btn_label }}</a>
              {% endif %}
              {% if block.settings.secondary_btn_label != blank %}
                <a href="{{ block.settings.secondary_btn_url }}" class="button button--secondary">{{ block.settings.secondary_btn_label }}</a>
              {% endif %}
            </div>
          </div>
          {% if block.settings.hero_image != blank %}
            <div class="hero-image">
              {{ block.settings.hero_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: block.settings.heading }}
            </div>
          {% endif %}
        </section>

      {% when 'why_upgrade' %}
        <section class="section-why-upgrade" {{ block.shopify_attributes }}>
          <h2>{{ block.settings.heading | escape }}</h2>
          <p class="lead-in">{{ block.settings.subtext | escape }}</p>
          <ul class="pain-points-list">
            {% if block.settings.point_1 != blank %}<li>{{ block.settings.point_1 }}</li>{% endif %}
            {% if block.settings.point_2 != blank %}<li>{{ block.settings.point_2 }}</li>{% endif %}
            {% if block.settings.point_3 != blank %}<li>{{ block.settings.point_3 }}</li>{% endif %}
            {% if block.settings.point_4 != blank %}<li>{{ block.settings.point_4 }}</li>{% endif %}
            {% if block.settings.point_5 != blank %}<li>{{ block.settings.point_5 }}</li>{% endif %}
          </ul>
          <div class="solution-callout">
            <p>{{ block.settings.solution_text | escape }}</p>
            <p><strong>{{ block.settings.tagline_1 | escape }}</strong> — {{ block.settings.tagline_2 | escape }}</p>
          </div>
        </section>

      {% when 'use_case' %}
        <section class="section-use-cases" {{ block.shopify_attributes }}>
          <h2>{{ block.settings.heading | escape }}</h2>
          <div class="grid-3">
            {% for i in (1..3) %}
              {% assign title_key = 'card_title_' | append: i %}
              {% assign text_key = 'card_text_' | append: i %}
              {% assign img_key = 'card_img_' | append: i %}
              {% if block.settings[title_key] != blank %}
                <div class="card">
                  {% if block.settings[img_key] != blank %}
                    {{ block.settings[img_key] | image_url: width: 600 | image_tag: loading: 'lazy' }}
                  {% endif %}
                  <h3>{{ block.settings[title_key] }}</h3>
                  <p>{{ block.settings[text_key] }}</p>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </section>

      {% when 'dds_info' %}
        <section class="section-dds-info" {{ block.shopify_attributes }}>
          <h2>{{ block.settings.heading | escape }}</h2>
          {% if block.settings.cutaway_image != blank %}
            <div style="text-align: center; margin-bottom: 24px;">
              {{ block.settings.cutaway_image | image_url: width: 1000 | image_tag: loading: 'lazy', style: 'max-width:100%; height:auto;' }}
            </div>
          {% endif %}
          <div style="max-width: 800px; margin: 0 auto; text-align: center;">
            <p><em>{{ block.settings.traditional_vs | escape }}</em></p>
            <p><strong>{{ block.settings.dds_how_it_works | escape }}</strong></p>
            <hr style="margin: 30px 0; border: none; border-top: 1px solid #ddd;">
            <h3>Benefits</h3>
            <ul style="list-style: none; padding: 0; line-height: 2;">
              {% if block.settings.benefit_1 != blank %}<li>✅ {{ block.settings.benefit_1 }}</li>{% endif %}
              {% if block.settings.benefit_2 != blank %}<li>✅ {{ block.settings.benefit_2 }}</li>{% endif %}
              {% if block.settings.benefit_3 != blank %}<li>✅ {{ block.settings.benefit_3 }}</li>{% endif %}
              {% if block.settings.benefit_4 != blank %}<li>✅ {{ block.settings.benefit_4 }}</li>{% endif %}
              {% if block.settings.benefit_5 != blank %}<li>✅ {{ block.settings.benefit_5 }}</li>{% endif %}
            </ul>
          </div>
        </section>

      {% when 'jeep_select' %}
        <section class="section-jeep-select" {{ block.shopify_attributes }}>
          <h2>{{ block.settings.heading | escape }}</h2>
          <div class="grid-5">
            {% for i in (1..5) %}
              {% assign name_key = 'jeep_name_' | append: i %}
              {% assign link_key = 'jeep_url_' | append: i %}
              {% if block.settings[name_key] != blank %}
                <a href="{{ block.settings[link_key] | default: '#' }}" class="card">
                  <h3>{{ block.settings[name_key] }}</h3>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </section>

      {% when 'axle_select' %}
        <section class="section-axle-select" {{ block.shopify_attributes }}>
          <h2>{{ block.settings.heading | escape }}</h2>
          <div class="grid-4">
            {% for i in (1..4) %}
              {% assign name_key = 'axle_name_' | append: i %}
              {% assign img_key = 'axle_img_' | append: i %}
              {% assign link_key = 'axle_url_' | append: i %}
              {% if block.settings[name_key] != blank %}
                <a href="{{ block.settings[link_key] | default: '#' }}" class="card">
                  {% if block.settings[img_key] != blank %}
                    {{ block.settings[img_key] | image_url: width: 400 | image_tag: loading: 'lazy' }}
                  {% endif %}
                  <h3>{{ block.settings[name_key] }}</h3>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </section>

      {% when 'system_builder' %}
        <section class="section-system-builder" {{ block.shopify_attributes }}>
          <h2>{{ block.settings.heading | escape }}</h2>
          <p style="text-align: center;">{{ block.settings.subheading | escape }}</p>
          <div class="system-flow">
            <div class="flow-step"><h4>XD Steering Gear</h4></div>
            <div class="flow-arrow">↓</div>
            <div class="flow-step"><h4>High Performance Pump Kit</h4></div>
            <div class="flow-arrow">↓</div>
            <div class="flow-step"><h4>Dynamic Damping Stabilizer®</h4></div>
            <div class="flow-arrow">↓</div>
            <div class="flow-step"><h4>XTREME-DUTY Hoses</h4></div>
          </div>
        </section>

      {% when 'existing_customers' %}
        <section class="section-existing-customers" style="text-align: center;" {{ block.shopify_attributes }}>
          <h2>{{ block.settings.heading | escape }}</h2>
          <h3 style="color: #666;">{{ block.settings.subheading | escape }}</h3>
          <p style="max-width: 600px; margin: 0 auto 24px;">{{ block.settings.description | escape }}</p>
          {% if block.settings.addon_product != blank %}
            <a href="{{ block.settings.addon_product.url }}" class="button button--primary">View Add-On Axle Kits</a>
          {% endif %}
        </section>

      {% when 'gallery_grid' %}
        <section class="section-gallery" {{ block.shopify_attributes }}>
          <h2>{{ block.settings.heading | escape }}</h2>
          <p style="text-align: center; margin-bottom: 30px;">{{ block.settings.subheading | escape }}</p>
          <div class="grid-5">
            {% for i in (1..5) %}
              {% assign img_key = 'gallery_img_' | append: i %}
              {% assign caption_key = 'gallery_cap_' | append: i %}
              {% if block.settings[img_key] != blank %}
                <div class="card" style="padding: 10px;">
                  {{ block.settings[img_key] | image_url: width: 600 | image_tag: loading: 'lazy' }}
                  {% if block.settings[caption_key] != blank %}
                    <span style="font-weight: bold; font-size: 0.9rem;">{{ block.settings[caption_key] }}</span>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </section>

      {% when 'contact' %}
        <section class="section-contact" {{ block.shopify_attributes }}>
          <h2>{{ block.settings.heading | escape }}</h2>
          <p>{{ block.settings.subheading | escape }}</p>
          <div class="contact-details">
            <a href="tel:{{ block.settings.phone }}">{{ block.settings.phone }}</a>
            <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
          </div>
        </section>

    {% endcase %}
  {% endfor %}

</div>

{% schema %}
