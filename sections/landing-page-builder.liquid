  "presets": [
    {
      "name": "Landing Page Builder",
      "blocks": [
        { "type": "hero" },
        { "type": "feature_overview" },
        { "type": "card_grid" },
        { "type": "system_builder" },
        { "type": "order_guide" },
        { "type": "faq_item" }
      ]
    }
  ]
}
