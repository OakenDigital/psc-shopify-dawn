{% doc %}
  @prompt
    i want a carousel with our different categories
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-category-carousel-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 32px 0;
  }

  .ai-category-carousel-{{ ai_gen_id }}__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
    padding: 0 16px;
  }

  .ai-category-carousel-{{ ai_gen_id }}__heading {
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    color: {{ block.settings.text_color }};
  }

  .ai-category-carousel-{{ ai_gen_id }}__controls {
    display: flex;
    gap: 8px;
  }

  .ai-category-carousel-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid {{ block.settings.text_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    cursor: pointer;
  }

  .ai-category-carousel-{{ ai_gen_id }}__button:hover:not(:disabled),
  .ai-category-carousel-{{ ai_gen_id }}__button:focus-visible {
    background: {{ block.settings.text_color }};
    color: {{ block.settings.background_color }};
  }

  .ai-category-carousel-{{ ai_gen_id }}__button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .ai-category-carousel-{{ ai_gen_id }}__viewport {
    overflow: hidden;
    padding: 0 16px;
  }

  .ai-category-carousel-{{ ai_gen_id }}__track {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
  }

  .ai-category-carousel-{{ ai_gen_id }}__track::-webkit-scrollbar {
    display: none;
  }

  .ai-category-carousel-{{ ai_gen_id }}__card {
    flex: 0 0 calc((100% - ({{ block.settings.cards_desktop | minus: 1 }} * {{ block.settings.card_gap }}px)) / {{ block.settings.cards_desktop }});
    min-width: 0;
    scroll-snap-align: start;
    color: {{ block.settings.text_color }};
    text-decoration: none;
  }

  .ai-category-carousel-{{ ai_gen_id }}__image,
  .ai-category-carousel-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: {{ block.settings.border_radius }}px;
    background: #e8e8e8;
  }

  .ai-category-carousel-{{ ai_gen_id }}__placeholder {
    overflow: hidden;
  }

  .ai-category-carousel-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
  }

  .ai-category-carousel-{{ ai_gen_id }}__title {
    display: block;
    margin-top: 12px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    .ai-category-carousel-{{ ai_gen_id }}__inner {
      padding: 24px 0;
    }

    .ai-category-carousel-{{ ai_gen_id }}__card {
      flex-basis: calc((100% - {{ block.settings.card_gap }}px) / 2);
    }
  }
{% endstyle %}

<category-carousel-{{ ai_gen_id }} class="ai-category-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-carousel-{{ ai_gen_id }}__inner">
    <div class="ai-category-carousel-{{ ai_gen_id }}__header">
      <h2 class="ai-category-carousel-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
      <div class="ai-category-carousel-{{ ai_gen_id }}__controls">
        <button type="button" class="ai-category-carousel-{{ ai_gen_id }}__button" data-direction="previous" aria-label="Previous categories">&#8592;</button>
        <button type="button" class="ai-category-carousel-{{ ai_gen_id }}__button" data-direction="next" aria-label="Next categories">&#8594;</button>
      </div>
    </div>

    <div class="ai-category-carousel-{{ ai_gen_id }}__viewport">
      <div class="ai-category-carousel-{{ ai_gen_id }}__track" tabindex="0">
        {% for collection in block.settings.collections %}
          <a class="ai-category-carousel-{{ ai_gen_id }}__card" href="{{ collection.url }}" aria-label="View {{ collection.title | escape }}">
            {% if collection.featured_image %}
              <img class="ai-category-carousel-{{ ai_gen_id }}__image" src="{{ collection.featured_image | image_url: width: 900 }}" alt="{{ collection.featured_image.alt | default: collection.title | escape }}" loading="lazy" width="900" height="900">
            {% else %}
              <div class="ai-category-carousel-{{ ai_gen_id }}__placeholder">{{ 'collection-apparel-1' | placeholder_svg_tag }}</div>
            {% endif %}
            <span class="ai-category-carousel-{{ ai_gen_id }}__title">{{ collection.title | escape }}</span>
          </a>
        {% else %}
          <div class="ai-category-carousel-{{ ai_gen_id }}__card">
            <div class="ai-category-carousel-{{ ai_gen_id }}__placeholder">{{ 'collection-apparel-1' | placeholder_svg_tag }}</div>
            <span class="ai-category-carousel-{{ ai_gen_id }}__title">Select collections in the theme editor</span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</category-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CategoryCarousel{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.ai-category-carousel-{{ ai_gen_id }}__track');
        this.buttons = this.querySelectorAll('.ai-category-carousel-{{ ai_gen_id }}__button');
        this.buttons.forEach((button) => button.addEventListener('click', () => this.move(button.dataset.direction)));
        this.track.addEventListener('scroll', () => this.updateButtons());
        this.updateButtons();
      }

      move(direction) {
        const card = this.track.querySelector('.ai-category-carousel-{{ ai_gen_id }}__card');
        if (!card) return;
        const distance = card.getBoundingClientRect().width + {{ block.settings.card_gap }};
        this.track.scrollBy({ left: direction === 'next' ? distance : -distance, behavior: 'smooth' });
      }

      updateButtons() {
        const atStart = this.track.scrollLeft <= 1;
        const atEnd = this.track.scrollLeft + this.track.clientWidth >= this.track.scrollWidth - 1;
        this.buttons.forEach((button) => {
          button.disabled = button.dataset.direction === 'previous' ? atStart : atEnd;
        });
      }
    }

    if (!customElements.get('category-carousel-{{ ai_gen_id }}')) {
      customElements.define('category-carousel-{{ ai_gen_id }}', CategoryCarousel{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Category carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 12
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "cards_desktop",
      "label": "Cards on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    }
  ],
  "presets": [
    {
      "name": "Category carousel"
    }
  ],
  "tag": null,
  "class": "category-carousel-block"
}
{% endschema %}