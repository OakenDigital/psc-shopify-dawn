{% doc %}
  @prompt
    Create a full-width homepage hero section for an automotive parts store. The section should have a full-width background image with a dark overlay, a bold headline like "Find the Right Parts" and a short subheadline, and a centered card/panel that embeds the PartFinder: Year Make Model app widget (using its app embed or liquid tag). The widget panel should have a clean white or dark background with Year, Make, and Model dropdowns and a prominent "Find Parts" button. The layout should be responsive and match the style of premium automotive aftermarket brands.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-parts-hero-{{ ai_gen_id }} {
    position: relative;
    display: block;
    width: 100%;
    min-height: {{ block.settings.hero_height }}px;
    overflow: hidden;
    background: {{ block.settings.fallback_background }};
    color: #ffffff;
  }

  .ai-parts-hero-{{ ai_gen_id }}__media,
  .ai-parts-hero-{{ ai_gen_id }}__media img,
  .ai-parts-hero-{{ ai_gen_id }}__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ai-parts-hero-{{ ai_gen_id }}__media img {
    object-fit: cover;
  }

  .ai-parts-hero-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #333333;
  }

  .ai-parts-hero-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    opacity: 0.35;
  }

  .ai-parts-hero-{{ ai_gen_id }}__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
  }

  .ai-parts-hero-{{ ai_gen_id }}__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-height: {{ block.settings.hero_height }}px;
    margin: 0 auto;
    padding: 56px 24px;
    text-align: center;
  }

  .ai-parts-hero-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 12px;
    color: {{ block.settings.accent_color }};
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ai-parts-hero-{{ ai_gen_id }}__heading {
    max-width: 760px;
    margin: 0;
    color: #ffffff;
    font-size: clamp(36px, 6vw, {{ block.settings.heading_size }}px);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .ai-parts-hero-{{ ai_gen_id }}__subheading {
    max-width: 620px;
    margin: 16px 0 28px;
    color: #ffffff;
    font-size: 18px;
    line-height: 1.5;
  }

  .ai-parts-hero-{{ ai_gen_id }}__panel {
    width: min(760px, 100%);
    padding: 22px;
    background: {{ block.settings.panel_color }};
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: {{ block.settings.panel_radius }}px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.3);
    color: {{ block.settings.panel_text_color }};
    text-align: left;
  }

  .ai-parts-hero-{{ ai_gen_id }}__panel-title {
    margin: 0 0 16px;
    color: {{ block.settings.panel_text_color }};
    font-size: 16px;
    font-weight: 700;
  }

  .ai-parts-hero-{{ ai_gen_id }}__fields {
    display: grid;
    grid-template-columns: repeat(3, 1fr) auto;
    gap: 12px;
    align-items: end;
  }

  .ai-parts-hero-{{ ai_gen_id }}__field label {
    display: block;
    margin-bottom: 6px;
    color: {{ block.settings.panel_text_color }};
    font-size: 12px;
    font-weight: 700;
  }

  .ai-parts-hero-{{ ai_gen_id }}__field select,
  .ai-parts-hero-{{ ai_gen_id }}__button {
    box-sizing: border-box;
    width: 100%;
    min-height: 48px;
    padding: 0 14px;
    border-radius: {{ block.settings.input_radius }}px;
    font: inherit;
  }

  .ai-parts-hero-{{ ai_gen_id }}__field select {
    border: 1px solid #777777;
    background: #ffffff;
    color: #121212;
  }

  .ai-parts-hero-{{ ai_gen_id }}__button {
    border: 0;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
  }

  .ai-parts-hero-{{ ai_gen_id }}__button:hover,
  .ai-parts-hero-{{ ai_gen_id }}__button:focus-visible {
    filter: brightness(0.88);
  }

  @media screen and (max-width: 749px) {
    .ai-parts-hero-{{ ai_gen_id }},
    .ai-parts-hero-{{ ai_gen_id }}__content {
      min-height: {{ block.settings.mobile_height }}px;
    }

    .ai-parts-hero-{{ ai_gen_id }}__content {
      padding: 44px 16px;
    }

    .ai-parts-hero-{{ ai_gen_id }}__subheading {
      font-size: 16px;
    }

    .ai-parts-hero-{{ ai_gen_id }}__fields {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<parts-finder-{{ ai_gen_id }} class="ai-parts-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-parts-hero-{{ ai_gen_id }}__media">
    {% if block.settings.background_image %}
      <img src="{{ block.settings.background_image | image_url: width: 2400 }}" alt="{{ block.settings.background_image.alt | escape }}" loading="eager" width="{{ block.settings.background_image.width }}" height="{{ block.settings.background_image.height }}">
    {% else %}
      <div class="ai-parts-hero-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
    {% endif %}
  </div>
  <div class="ai-parts-hero-{{ ai_gen_id }}__overlay"></div>
  <div class="ai-parts-hero-{{ ai_gen_id }}__content">
    {% if block.settings.eyebrow != blank %}<p class="ai-parts-hero-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
    <h1 class="ai-parts-hero-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h1>
    {% if block.settings.subheading != blank %}<p class="ai-parts-hero-{{ ai_gen_id }}__subheading">{{ block.settings.subheading }}</p>{% endif %}
    <div class="ai-parts-hero-{{ ai_gen_id }}__panel">
      {% if block.settings.widget_liquid != blank %}
        {{ block.settings.widget_liquid }}
      {% else %}
        <p class="ai-parts-hero-{{ ai_gen_id }}__panel-title">{{ block.settings.panel_title }}</p>
        <div class="ai-parts-hero-{{ ai_gen_id }}__fields">
          <div class="ai-parts-hero-{{ ai_gen_id }}__field"><label for="ai-year-{{ ai_gen_id }}">Year</label><select id="ai-year-{{ ai_gen_id }}"><option>Select year</option></select></div>
          <div class="ai-parts-hero-{{ ai_gen_id }}__field"><label for="ai-make-{{ ai_gen_id }}">Make</label><select id="ai-make-{{ ai_gen_id }}"><option>Select make</option></select></div>
          <div class="ai-parts-hero-{{ ai_gen_id }}__field"><label for="ai-model-{{ ai_gen_id }}">Model</label><select id="ai-model-{{ ai_gen_id }}"><option>Select model</option></select></div>
          <button class="ai-parts-hero-{{ ai_gen_id }}__button" type="button">{{ block.settings.button_label }}</button>
        </div>
      {% endif %}
    </div>
  </div>
</parts-finder-{{ ai_gen_id }}>

<script>
  (function() {
    if (!customElements.get('parts-finder-{{ ai_gen_id }}')) {
      customElements.define('parts-finder-{{ ai_gen_id }}', class extends HTMLElement {});
    }
  })();
</script>

{% schema %}
{
  "name": "Parts finder hero",
  "tag": null,
  "class": "parts-finder-hero-block",
  "settings": [
    { "type": "header", "content": "Hero content" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PSC performance" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Find the right parts" },
    { "type": "textarea", "id": "subheading", "label": "Subheadline", "default": "Engineered components for confident builds, tuned for the way you drive." },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "hero_height", "label": "Desktop height", "min": 420, "max": 900, "step": 20, "unit": "px", "default": 680 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 480, "max": 900, "step": 20, "unit": "px", "default": 680 },
    { "type": "range", "id": "heading_size", "label": "Headline size", "min": 40, "max": 96, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 40, "max": 90, "step": 5, "unit": "%", "default": 65 },
    { "type": "color", "id": "fallback_background", "label": "Fallback background", "default": "#242424" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#d6001c" },
    { "type": "header", "content": "Part finder" },
    { "type": "paragraph", "content": "Paste the PartFinder app widget Liquid tag or app markup below. Leave it blank to show a styled preview panel." },
    { "type": "liquid", "id": "widget_liquid", "label": "Widget Liquid" },
    { "type": "text", "id": "panel_title", "label": "Panel title", "default": "Select your vehicle" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Find parts" },
    { "type": "color", "id": "panel_color", "label": "Panel background", "default": "#ffffff" },
    { "type": "color", "id": "panel_text_color", "label": "Panel text", "default": "#121212" },
    { "type": "color", "id": "button_color", "label": "Button background", "default": "#d6001c" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "range", "id": "panel_radius", "label": "Panel radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "input_radius", "label": "Input radius", "min": 0, "max": 20, "step": 2, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Parts finder hero" }]
}
{% endschema %}