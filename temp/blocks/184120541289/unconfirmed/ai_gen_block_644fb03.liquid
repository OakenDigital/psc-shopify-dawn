{% doc %}
  @prompt
    Create an image banner section that matches the constrained width of an "image with text" section (medium desktop width container). The banner should be centered on the page with the same max-width container as the image with text section, rather than being full-width. It should support a background image, adjustable image height, content overlay with heading and button, and content positioning controls — matching the standard image banner functionality but constrained to a centered content-width container.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-constrained-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 0 20px;
  }

  .ai-constrained-banner-{{ ai_gen_id }}__frame {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 1200px;
    min-height: {{ block.settings.banner_height }}px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: {{ block.settings.corner_radius }}px;
    background: {{ block.settings.fallback_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-constrained-banner-{{ ai_gen_id }}__media,
  .ai-constrained-banner-{{ ai_gen_id }}__overlay {
    position: absolute;
    inset: 0;
  }

  .ai-constrained-banner-{{ ai_gen_id }}__media img,
  .ai-constrained-banner-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-constrained-banner-{{ ai_gen_id }}__placeholder {
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.banner_height }}px;
    background: {{ block.settings.fallback_color }};
  }

  .ai-constrained-banner-{{ ai_gen_id }}__placeholder svg {
    color: {{ block.settings.text_color }};
    opacity: 0.35;
  }

  .ai-constrained-banner-{{ ai_gen_id }}__overlay {
    background: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
  }

  .ai-constrained-banner-{{ ai_gen_id }}__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.vertical_position }};
    align-items: {{ block.settings.horizontal_position }};
    height: 100%;
    min-height: {{ block.settings.banner_height }}px;
    padding: 32px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-constrained-banner-{{ ai_gen_id }}__content-inner {
    max-width: 560px;
  }

  .ai-constrained-banner-{{ ai_gen_id }}__heading {
    margin: 0 0 18px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.1;
  }

  .ai-constrained-banner-{{ ai_gen_id }}__button {
    display: inline-block;
    padding: 12px 24px;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-weight: 700;
  }

  .ai-constrained-banner-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-constrained-banner-{{ ai_gen_id }} { padding: 0 16px; }
    .ai-constrained-banner-{{ ai_gen_id }}__frame,
    .ai-constrained-banner-{{ ai_gen_id }}__content,
    .ai-constrained-banner-{{ ai_gen_id }}__placeholder { min-height: {{ block.settings.mobile_height }}px; }
    .ai-constrained-banner-{{ ai_gen_id }}__content { padding: 24px; }
    .ai-constrained-banner-{{ ai_gen_id }}__heading { font-size: {{ block.settings.mobile_heading_size }}px; }
  }
{% endstyle %}

<div class="ai-constrained-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-constrained-banner-{{ ai_gen_id }}__frame">
    <div class="ai-constrained-banner-{{ ai_gen_id }}__media">
      {% if block.settings.background_image %}
        <img src="{{ block.settings.background_image | image_url: width: 1800 }}" alt="{{ block.settings.background_image.alt | escape }}" loading="lazy" width="{{ block.settings.background_image.width }}" height="{{ block.settings.background_image.height }}">
      {% else %}
        <div class="ai-constrained-banner-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
      {% endif %}
    </div>
    <div class="ai-constrained-banner-{{ ai_gen_id }}__overlay"></div>
    <div class="ai-constrained-banner-{{ ai_gen_id }}__content">
      <div class="ai-constrained-banner-{{ ai_gen_id }}__content-inner">
        {% if block.settings.heading != blank %}<h2 class="ai-constrained-banner-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
        {% if block.settings.button_label != blank and block.settings.button_link != blank %}<a class="ai-constrained-banner-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>{% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Constrained image banner",
  "settings": [
    { "type": "header", "content": "Banner" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "banner_height", "label": "Desktop height", "min": 240, "max": 700, "step": 20, "unit": "px", "default": 440 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 180, "max": 500, "step": 20, "unit": "px", "default": 300 },
    { "type": "color", "id": "fallback_color", "label": "Fallback", "default": "#2d2926" },
    { "type": "color", "id": "overlay_color", "label": "Overlay", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for the road ahead" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "vertical_position", "label": "Vertical position", "options": [{ "value": "flex-start", "label": "Top" }, { "value": "center", "label": "Middle" }, { "value": "flex-end", "label": "Bottom" }], "default": "center" },
    { "type": "select", "id": "horizontal_position", "label": "Horizontal position", "options": [{ "value": "flex-start", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "flex-end", "label": "Right" }], "default": "center" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 64, "step": 2, "unit": "px", "default": 42 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 18, "max": 44, "step": 2, "unit": "px", "default": 30 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#ffffff" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#121212" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#ffffff" },
    { "type": "range", "id": "button_border_width", "label": "Button border", "min": 0, "max": 6, "step": 1, "unit": "px", "default": 1 },
    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Constrained image banner" }],
  "tag": null,
  "class": "constrained-image-banner"
}
{% endschema %}