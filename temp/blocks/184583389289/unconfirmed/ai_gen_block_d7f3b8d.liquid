{% doc %}
  @prompt
    Update the existing Installation guide block on this page to add a new "Year Range" text field in the cover section, positioned between the Guide Application (main red product title) and the Part # (compatible part numbers with red square bullets). The Year Range field should display centered below the title in clean dark/black text, slightly smaller than the main title (e.g. "2014+", "2010–2018"). It must be editable in the Shopify theme editor settings panel with the label "Year Range". Keep all other existing fields and sections of the block intact — Guide Part Name (small caps eyebrow), Guide Application (large bold red title), Part # (bulleted list), kit image, Installation Guide footer label, interior sections with diagonal stripe headers, Table of Contents, Before You Get Started, What's in the Kit, Step-by-Step Installation, and Contact Us.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-installation-guide-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; margin: 0 auto; color: #121212; font-family: system-ui, sans-serif; }
  .ai-installation-guide-{{ ai_gen_id }}__cover { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 40%); gap: 48px; align-items: center; padding: 48px 0; }
  .ai-installation-guide-{{ ai_gen_id }}__cover-copy { text-align: center; }
  .ai-installation-guide-{{ ai_gen_id }}__eyebrow { margin: 0 0 12px; font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .ai-installation-guide-{{ ai_gen_id }}__title { margin: 0; color: #d6001c; font-size: clamp(28px, 4vw, 52px); line-height: 1.05; font-weight: 800; }
  .ai-installation-guide-{{ ai_gen_id }}__year { margin: 10px 0 18px; color: #121212; font-size: clamp(16px, 2vw, 22px); line-height: 1.2; font-weight: 600; }
  .ai-installation-guide-{{ ai_gen_id }}__parts { display: inline-block; margin: 0; padding: 0; list-style: none; text-align: left; font-size: 15px; line-height: 1.7; }
  .ai-installation-guide-{{ ai_gen_id }}__parts li { position: relative; padding-left: 18px; }
  .ai-installation-guide-{{ ai_gen_id }}__parts li::before { content: ''; position: absolute; top: .65em; left: 0; width: 8px; height: 8px; background: #d6001c; }
  .ai-installation-guide-{{ ai_gen_id }}__image, .ai-installation-guide-{{ ai_gen_id }}__placeholder { width: 100%; aspect-ratio: 1 / 1; object-fit: contain; }
  .ai-installation-guide-{{ ai_gen_id }}__placeholder { display: flex; align-items: center; justify-content: center; background: #f3f3f3; }
  .ai-installation-guide-{{ ai_gen_id }}__placeholder svg { width: 70%; height: 70%; }
  .ai-installation-guide-{{ ai_gen_id }}__footer { padding: 16px 0; border-top: 2px solid #d6001c; border-bottom: 2px solid #d6001c; text-align: center; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .ai-installation-guide-{{ ai_gen_id }}__section { padding: 32px 0; }
  .ai-installation-guide-{{ ai_gen_id }}__heading { margin: 0 0 18px; padding: 12px 18px; color: #fff; background: #121212; font-size: 22px; line-height: 1.2; font-weight: 700; clip-path: polygon(0 0, 100% 0, 96% 100%, 0 100%); }
  .ai-installation-guide-{{ ai_gen_id }}__content { font-size: 16px; line-height: 1.65; }
  .ai-installation-guide-{{ ai_gen_id }}__content p { margin: 0 0 12px; }
  @media screen and (max-width: 749px) { .ai-installation-guide-{{ ai_gen_id }}__cover { grid-template-columns: 1fr; gap: 24px; padding: 32px 0; } }
{% endstyle %}

<div class="ai-installation-guide-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-installation-guide-{{ ai_gen_id }}__cover">
    <div class="ai-installation-guide-{{ ai_gen_id }}__cover-copy">
      {% if block.settings.guide_part_name != blank %}<p class="ai-installation-guide-{{ ai_gen_id }}__eyebrow">{{ block.settings.guide_part_name | escape }}</p>{% endif %}
      {% if block.settings.guide_application != blank %}<h1 class="ai-installation-guide-{{ ai_gen_id }}__title">{{ block.settings.guide_application | escape }}</h1>{% endif %}
      {% if block.settings.year_range != blank %}<p class="ai-installation-guide-{{ ai_gen_id }}__year">{{ block.settings.year_range | escape }}</p>{% endif %}
      {% if block.settings.part_numbers != blank %}<ul class="ai-installation-guide-{{ ai_gen_id }}__parts">{% assign parts = block.settings.part_numbers | newline_to_br | split: '<br />' %}{% for part in parts %}{% assign clean_part = part | strip %}{% if clean_part != blank %}<li>{{ clean_part | escape }}</li>{% endif %}{% endfor %}</ul>{% endif %}
    </div>
    <div class="ai-installation-guide-{{ ai_gen_id }}__cover-media">{% if block.settings.kit_image %}<img class="ai-installation-guide-{{ ai_gen_id }}__image" src="{{ block.settings.kit_image | image_url: width: 1200 }}" alt="{{ block.settings.kit_image.alt | escape }}" loading="lazy" width="{{ block.settings.kit_image.width }}" height="{{ block.settings.kit_image.height }}">{% else %}<div class="ai-installation-guide-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</div>
  </div>
  {% if block.settings.footer_label != blank %}<div class="ai-installation-guide-{{ ai_gen_id }}__footer">{{ block.settings.footer_label | escape }}</div>{% endif %}
  {% for i in (1..5) %}
    {% assign heading_key = 'section_' | append: i | append: '_heading' %}
    {% assign content_key = 'section_' | append: i | append: '_content' %}
    {% assign heading = block.settings[heading_key] %}
    {% assign content = block.settings[content_key] %}
    {% if heading != blank or content != blank %}<section class="ai-installation-guide-{{ ai_gen_id }}__section">{% if heading != blank %}<h2 class="ai-installation-guide-{{ ai_gen_id }}__heading">{{ heading | escape }}</h2>{% endif %}{% if content != blank %}<div class="ai-installation-guide-{{ ai_gen_id }}__content">{{ content }}</div>{% endif %}</section>{% endif %}
  {% endfor %}
</div>

{% schema %}
{"name":"Installation guide","tag":null,"class":"installation-guide-block","settings":[{"type":"header","content":"Cover"},{"type":"text","id":"guide_part_name","label":"Guide part name","default":"Installation guide"},{"type":"text","id":"guide_application","label":"Guide application","default":"Steering assist kit"},{"type":"text","id":"year_range","label":"Year Range"},{"type":"textarea","id":"part_numbers","label":"Part numbers","default":"PSC-001\nPSC-002"},{"type":"image_picker","id":"kit_image","label":"Kit image"},{"type":"text","id":"footer_label","label":"Footer label","default":"Installation guide"},{"type":"header","content":"Interior sections"},{"type":"text","id":"section_1_heading","label":"Section 1 heading","default":"Table of Contents"},{"type":"richtext","id":"section_1_content","label":"Section 1 content","default":"<p>Add the table of contents here.</p>"},{"type":"text","id":"section_2_heading","label":"Section 2 heading","default":"Before You Get Started"},{"type":"richtext","id":"section_2_content","label":"Section 2 content","default":"<p>Add important preparation information here.</p>"},{"type":"text","id":"section_3_heading","label":"Section 3 heading","default":"What's in the Kit"},{"type":"richtext","id":"section_3_content","label":"Section 3 content","default":"<p>List the components included in the kit here.</p>"},{"type":"text","id":"section_4_heading","label":"Section 4 heading","default":"Step-by-Step Installation"},{"type":"richtext","id":"section_4_content","label":"Section 4 content","default":"<p>Add installation steps here.</p>"},{"type":"text","id":"section_5_heading","label":"Section 5 heading","default":"Contact Us"},{"type":"richtext","id":"section_5_content","label":"Section 5 content","default":"<p>Add contact information here.</p>"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Installation guide"}]}
{% endschema %}