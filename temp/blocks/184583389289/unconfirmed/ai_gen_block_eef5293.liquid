{% doc %}
  @prompt
    Create a custom install guide page template for an automotive performance parts brand (PSC Motorsports). The template should include structured sections for: a hero area with the guide title and a featured image, an intro/overview section, a required tools and parts list, a step-by-step installation instructions section with numbered steps (each step can have an image and description), a notes/warnings section for torque specs or cautions, and a related products section to link to relevant parts. The design should feel premium and engineering-driven — clean layout, strong typography, and professional. All sections should be customizable in the theme editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-install-guide-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    font-family: {{ block.settings.body_font.family }};
  }
  .ai-install-guide-{{ ai_gen_id }}__inner { max-width: 1200px; margin: 0 auto; }
  .ai-install-guide-{{ ai_gen_id }}__hero { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; padding: 64px 6%; background: {{ block.settings.hero_background }}; }
  .ai-install-guide-{{ ai_gen_id }}__eyebrow { margin: 0 0 16px; color: {{ block.settings.accent_color }}; font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .ai-install-guide-{{ ai_gen_id }} h1, .ai-install-guide-{{ ai_gen_id }} h2, .ai-install-guide-{{ ai_gen_id }} h3 { font-family: {{ block.settings.heading_font.family }}; color: {{ block.settings.heading_color }}; }
  .ai-install-guide-{{ ai_gen_id }} h1 { margin: 0; font-size: clamp(34px, 5vw, 64px); line-height: 1.05; letter-spacing: -.03em; }
  .ai-install-guide-{{ ai_gen_id }} h2 { margin: 0 0 24px; font-size: clamp(26px, 3vw, 40px); }
  .ai-install-guide-{{ ai_gen_id }}__hero-image img, .ai-install-guide-{{ ai_gen_id }}__step-image img { display: block; width: 100%; height: auto; object-fit: cover; }
  .ai-install-guide-{{ ai_gen_id }}__placeholder { display: flex; align-items: center; justify-content: center; min-height: 320px; background: #e8e8e8; color: #555; }
  .ai-install-guide-{{ ai_gen_id }}__placeholder svg { width: 100%; height: 100%; max-height: 420px; }
  .ai-install-guide-{{ ai_gen_id }}__empty { padding: 16px; text-align: center; font-size: 13px; }
  .ai-install-guide-{{ ai_gen_id }}__section { padding: 64px 6%; border-bottom: 1px solid {{ block.settings.rule_color }}; }
  .ai-install-guide-{{ ai_gen_id }}__content { max-width: 820px; line-height: 1.7; }
  .ai-install-guide-{{ ai_gen_id }}__columns { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .ai-install-guide-{{ ai_gen_id }}__list { margin: 0; padding-left: 22px; line-height: 1.9; }
  .ai-install-guide-{{ ai_gen_id }}__steps { display: grid; gap: 40px; }
  .ai-install-guide-{{ ai_gen_id }}__step { display: grid; grid-template-columns: 72px 1fr; gap: 24px; align-items: start; }
  .ai-install-guide-{{ ai_gen_id }}__number { display: flex; align-items: center; justify-content: center; width: 56px; height: 56px; border: 1px solid {{ block.settings.accent_color }}; color: {{ block.settings.accent_color }}; font-weight: 700; font-size: 18px; }
  .ai-install-guide-{{ ai_gen_id }}__step h3 { margin: 0 0 10px; font-size: 22px; }
  .ai-install-guide-{{ ai_gen_id }}__step-description { line-height: 1.7; }
  .ai-install-guide-{{ ai_gen_id }}__step-image { margin-top: 20px; max-width: 720px; }
  .ai-install-guide-{{ ai_gen_id }}__notes { padding: 32px; background: {{ block.settings.notes_background }}; border-left: 4px solid {{ block.settings.accent_color }}; }
  .ai-install-guide-{{ ai_gen_id }}__notes h2 { margin-bottom: 16px; font-size: 28px; }
  .ai-install-guide-{{ ai_gen_id }}__products { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .ai-install-guide-{{ ai_gen_id }}__product { border: 1px solid {{ block.settings.rule_color }}; padding: 18px; text-decoration: none; color: inherit; }
  .ai-install-guide-{{ ai_gen_id }}__product img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; margin-bottom: 16px; }
  .ai-install-guide-{{ ai_gen_id }}__product-title { margin: 0 0 8px; font-weight: 700; }
  .ai-install-guide-{{ ai_gen_id }}__product-price { color: {{ block.settings.muted_color }}; }
  @media screen and (max-width: 749px) {
    .ai-install-guide-{{ ai_gen_id }}__hero, .ai-install-guide-{{ ai_gen_id }}__columns { grid-template-columns: 1fr; }
    .ai-install-guide-{{ ai_gen_id }}__hero, .ai-install-guide-{{ ai_gen_id }}__section { padding: 40px 5%; }
    .ai-install-guide-{{ ai_gen_id }}__products { grid-template-columns: 1fr; }
    .ai-install-guide-{{ ai_gen_id }}__step { grid-template-columns: 48px 1fr; gap: 16px; }
    .ai-install-guide-{{ ai_gen_id }}__number { width: 44px; height: 44px; }
  }
{% endstyle %}

<install-guide-{{ ai_gen_id }} class="ai-install-guide-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-install-guide-{{ ai_gen_id }}__inner">
    <header class="ai-install-guide-{{ ai_gen_id }}__hero">
      <div>
        {% if block.settings.eyebrow != blank %}<p class="ai-install-guide-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
        <h1>{{ block.settings.title }}</h1>
      </div>
      <div class="ai-install-guide-{{ ai_gen_id }}__hero-image">
        {% if block.settings.hero_image %}<img src="{{ block.settings.hero_image | image_url: width: 1200 }}" alt="{{ block.settings.hero_image.alt | escape }}" loading="eager">{% else %}<div class="ai-install-guide-{{ ai_gen_id }}__placeholder">{{ 'hero-apparel-1' | placeholder_svg_tag }}<span class="ai-install-guide-{{ ai_gen_id }}__empty">Add a featured guide image</span></div>{% endif %}
      </div>
    </header>

    <section class="ai-install-guide-{{ ai_gen_id }}__section">
      <div class="ai-install-guide-{{ ai_gen_id }}__content">{% if block.settings.overview_heading != blank %}<h2>{{ block.settings.overview_heading }}</h2>{% endif %}{{ block.settings.overview }}</div>
    </section>

    <section class="ai-install-guide-{{ ai_gen_id }}__section">
      <div class="ai-install-guide-{{ ai_gen_id }}__columns">
        <div><h2>{{ block.settings.tools_heading }}</h2>{{ block.settings.tools_list }}</div>
        <div><h2>{{ block.settings.parts_heading }}</h2>{{ block.settings.parts_list }}</div>
      </div>
    </section>

    <section class="ai-install-guide-{{ ai_gen_id }}__section">
      <h2>{{ block.settings.steps_heading }}</h2>
      <div class="ai-install-guide-{{ ai_gen_id }}__steps">
        {% for i in (1..4) %}
          {% assign title_key = 'step_' | append: i | append: '_title' %}
          {% assign description_key = 'step_' | append: i | append: '_description' %}
          {% assign image_key = 'step_' | append: i | append: '_image' %}
          {% if block.settings[title_key] != blank or block.settings[description_key] != blank %}
            <article class="ai-install-guide-{{ ai_gen_id }}__step">
              <div class="ai-install-guide-{{ ai_gen_id }}__number">{{ i }}</div>
              <div><h3>{{ block.settings[title_key] }}</h3><div class="ai-install-guide-{{ ai_gen_id }}__step-description">{{ block.settings[description_key] }}</div>{% if block.settings[image_key] %}<div class="ai-install-guide-{{ ai_gen_id }}__step-image"><img src="{{ block.settings[image_key] | image_url: width: 1000 }}" alt="{{ block.settings[image_key].alt | escape }}" loading="lazy"></div>{% endif %}</div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>

    <section class="ai-install-guide-{{ ai_gen_id }}__section"><div class="ai-install-guide-{{ ai_gen_id }}__notes"><h2>{{ block.settings.notes_heading }}</h2>{{ block.settings.notes }}</div></section>

    <section class="ai-install-guide-{{ ai_gen_id }}__section">
      <h2>{{ block.settings.products_heading }}</h2>
      <div class="ai-install-guide-{{ ai_gen_id }}__products">
        {% for i in (1..3) %}
          {% assign product_key = 'product_' | append: i %}
          {% assign selected_product = block.settings[product_key] %}
          {% if selected_product != blank %}<a class="ai-install-guide-{{ ai_gen_id }}__product" href="{{ selected_product.url }}"><img src="{{ selected_product.featured_image | image_url: width: 600 }}" alt="{{ selected_product.featured_image.alt | default: selected_product.title | escape }}" loading="lazy"><p class="ai-install-guide-{{ ai_gen_id }}__product-title">{{ selected_product.title }}</p><span class="ai-install-guide-{{ ai_gen_id }}__product-price">{{ selected_product.price | money }}</span></a>{% endif %}
        {% endfor %}
      </div>
    </section>
  </div>
</install-guide-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Install guide",
  "tag": null,
  "class": "install-guide-block",
  "settings": [
    {"type":"header","content":"Guide header"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"PSC Motorsports installation guide"},
    {"type":"text","id":"title","label":"Guide title","default":"Install with confidence"},
    {"type":"image_picker","id":"hero_image","label":"Featured image"},
    {"type":"header","content":"Overview"},
    {"type":"text","id":"overview_heading","label":"Heading","default":"Before you begin"},
    {"type":"richtext","id":"overview","label":"Overview","default":"<p>Review the complete guide before beginning. Confirm the vehicle application, inspect all components, and follow the sequence below for a precise installation.</p>"},
    {"type":"header","content":"Tools and parts"},
    {"type":"text","id":"tools_heading","label":"Tools heading","default":"Required tools"},
    {"type":"richtext","id":"tools_list","label":"Tools list","default":"<ul><li>Complete socket and wrench set</li><li>Calibrated torque wrench</li><li>Vehicle-approved lifting equipment</li></ul>"},
    {"type":"text","id":"parts_heading","label":"Parts heading","default":"Required parts"},
    {"type":"richtext","id":"parts_list","label":"Parts list","default":"<ul><li>Installation hardware</li><li>Replacement seals and fittings</li><li>Approved fluid or lubricant</li></ul>"},
    {"type":"header","content":"Installation steps"},
    {"type":"text","id":"steps_heading","label":"Steps heading","default":"Installation instructions"},
    {"type":"text","id":"step_1_title","label":"Step 1 title","default":"Prepare the vehicle"},
    {"type":"richtext","id":"step_1_description","label":"Step 1 description","default":"<p>Secure the vehicle on a level surface, disconnect power where required, and verify that the work area is clean and accessible.</p>"},
    {"type":"image_picker","id":"step_1_image","label":"Step 1 image"},
    {"type":"text","id":"step_2_title","label":"Step 2 title","default":"Remove existing components"},
    {"type":"richtext","id":"step_2_description","label":"Step 2 description","default":"<p>Remove the original components methodically. Retain hardware only when the service procedure specifies reuse.</p>"},
    {"type":"image_picker","id":"step_2_image","label":"Step 2 image"},
    {"type":"text","id":"step_3_title","label":"Step 3 title","default":"Install the new assembly"},
    {"type":"richtext","id":"step_3_description","label":"Step 3 description","default":"<p>Position the assembly, start all fasteners by hand, and tighten evenly to prevent misalignment or damage.</p>"},
    {"type":"image_picker","id":"step_3_image","label":"Step 3 image"},
    {"type":"text","id":"step_4_title","label":"Step 4 title","default":"Verify and test"},
    {"type":"richtext","id":"step_4_description","label":"Step 4 description","default":"<p>Confirm clearances, inspect connections, apply the specified torque, and perform a controlled functional test.</p>"},
    {"type":"image_picker","id":"step_4_image","label":"Step 4 image"},
    {"type":"header","content":"Notes and warnings"},
    {"type":"text","id":"notes_heading","label":"Heading","default":"Important notes"},
    {"type":"richtext","id":"notes","label":"Notes","default":"<p><strong>Torque and safety:</strong> Always use the vehicle and component manufacturer specifications. Never substitute fasteners or operate the vehicle until all safety checks are complete.</p>"},
    {"type":"header","content":"Related products"},
    {"type":"text","id":"products_heading","label":"Heading","default":"Related parts"},
    {"type":"product","id":"product_1","label":"Product 1"},
    {"type":"product","id":"product_2","label":"Product 2"},
    {"type":"product","id":"product_3","label":"Product 3"},
    {"type":"header","content":"Style"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"font_picker","id":"heading_font","label":"Heading font","default":"system_ui_n4"},
    {"type":"font_picker","id":"body_font","label":"Body font","default":"system_ui_n4"},
    {"type":"color","id":"background_color","label":"Background","default":"#FFFFFF"},
    {"type":"color","id":"hero_background","label":"Hero background","default":"#F3F3F3"},
    {"type":"color","id":"heading_color","label":"Headings","default":"#121212"},
    {"type":"color","id":"text_color","label":"Text","default":"#121212"},
    {"type":"color","id":"accent_color","label":"Accent","default":"#D6001C"},
    {"type":"color","id":"rule_color","label":"Rules","default":"#D9D9D9"},
    {"type":"color","id":"notes_background","label":"Notes background","default":"#F3F3F3"},
    {"type":"color","id":"muted_color","label":"Muted text","default":"#555555"}
  ],
  "presets": [{"name":"Install guide"}]
}
{% endschema %}