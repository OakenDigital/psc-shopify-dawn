{% doc %}
  @prompt
    Create a complete PSC Motorsports Installation Guide section template for Shopify to be used on pages with the template suffix "install-instruction-templ". This section must use Shopify's native blocks system so merchants can add, remove, and reorder steps in the theme editor.
    
    PRINT FUNCTIONALITY:
    - A prominent "Print Guide" button fixed or positioned at the top of the page (styled in red #CC0000 with white text)
    - When clicked, triggers window.print()
    - Print CSS (@media print) must: hide Shopify header, footer, navigation, sidebars, and the print button itself; preserve all section layouts, images, and typography; use page-break-before on each major section and each step so it prints cleanly
    
    SECTION SETTINGS:
    - PSC Logo (image), Guide Category (small caps eyebrow with horizontal rules), Product Title (large bold red), Product Application (medium bold dark), Product Year (medium dark), Part Numbers (textarea with red square bullets), Kit Image (rounded border box), Table of Contents (rich text), Before You Get Started (rich text), What's in the Kit (rich text), Contact subheading (red), Contact phone/hours/email/website
    
    COVER: PSC logo centered, Guide Category eyebrow, two-column (Kit Image left; Product Title, Application, Year, Part Numbers stacked right), bold centered "INSTALLATION GUIDE" at bottom
    
    INTERIOR SECTIONS (diagonal black-to-gray stripe band + PSC logo on each): Table of Contents, Before You Get Started, What's in the Kit, Step-by-Step Installation, Contact Us
    
    BLOCKS - REPEATABLE STEPS (max 45): Each "step" block has: Step Title (gray pill header), Sub Label (bold), Instructions (rich text), Step Image (right column with circled number overlay). Two-column layout. Page break before each step when printing.
    
    DESIGN: red #CC0000, gray pill headers, Barlow Condensed Google Font, white background, fully responsive, all settings editable in theme editor
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% style %}.psc-guide-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;font-family:'Barlow Condensed','Arial Narrow',Arial,sans-serif;color:#121212;background:#fff}.psc-guide-{{ ai_gen_id }}__toolbar{display:flex;justify-content:flex-end;max-width:1100px;margin:0 auto 20px}.psc-guide-{{ ai_gen_id }}__print{background:#CC0000;color:#fff;border:0;padding:14px 24px;font-weight:700;cursor:pointer}.psc-guide-{{ ai_gen_id }}__page{max-width:1100px;margin:auto;padding:48px 36px}.psc-guide-{{ ai_gen_id }}__logo{display:block;max-width:190px;max-height:90px;margin:0 auto 28px}.psc-guide-{{ ai_gen_id }}__eyebrow{display:flex;gap:16px;align-items:center;justify-content:center;text-transform:uppercase;letter-spacing:.16em;font-size:13px;font-weight:700}.psc-guide-{{ ai_gen_id }}__eyebrow:before,.psc-guide-{{ ai_gen_id }}__eyebrow:after{content:'';height:1px;background:#777;flex:1}.psc-guide-{{ ai_gen_id }}__cover-grid{display:grid;grid-template-columns:1fr 1fr;gap:42px;align-items:center;margin:55px 0}.psc-guide-{{ ai_gen_id }}__kit{border:1px solid #bbb;border-radius:10px;padding:18px;text-align:center}.psc-guide-{{ ai_gen_id }}__kit img,.psc-guide-{{ ai_gen_id }}__step-media img{width:100%;height:auto}.psc-guide-{{ ai_gen_id }}__title{color:#CC0000;font-size:clamp(32px,5vw,58px);line-height:1;margin:0 0 16px}.psc-guide-{{ ai_gen_id }}__application,.psc-guide-{{ ai_gen_id }}__year{font-size:22px;font-weight:700}.psc-guide-{{ ai_gen_id }}__parts{white-space:pre-line;padding-left:24px}.psc-guide-{{ ai_gen_id }}__parts li{list-style:none;position:relative}.psc-guide-{{ ai_gen_id }}__parts li:before{content:'';width:8px;height:8px;background:#CC0000;position:absolute;left:-18px;top:9px}.psc-guide-{{ ai_gen_id }}__cover-label{text-align:center;font-size:34px;font-weight:800;letter-spacing:.08em}.psc-guide-{{ ai_gen_id }}__section{page-break-before:always}.psc-guide-{{ ai_gen_id }}__band{background:linear-gradient(145deg,#050505 0%,#050505 48%,#777 49%,#777 54%,#222 55%);padding:20px 28px;display:flex;align-items:center;gap:20px;color:#fff}.psc-guide-{{ ai_gen_id }}__band img{max-width:120px;max-height:48px;filter:brightness(0) invert(1);margin:0}.psc-guide-{{ ai_gen_id }}__band h2{margin:0;font-size:30px;text-transform:uppercase}.psc-guide-{{ ai_gen_id }}__content{padding:35px 0;font-size:18px}.psc-guide-{{ ai_gen_id }}__step{page-break-before:always;display:grid;grid-template-columns:1fr 1fr;gap:36px;padding:35px 0}.psc-guide-{{ ai_gen_id }}__pill{display:inline-block;background:#e4e4e4;border-radius:999px;padding:9px 18px;font-weight:800}.psc-guide-{{ ai_gen_id }}__step h3{font-size:28px}.psc-guide-{{ ai_gen_id }}__step-media{border:1px solid #bbb;border-radius:10px;overflow:hidden;position:relative}.psc-guide-{{ ai_gen_id }}__number{position:absolute;top:14px;left:14px;width:44px;height:44px;border-radius:50%;background:#CC0000;color:#fff;display:grid;place-items:center;font-weight:800}@media(max-width:749px){.psc-guide-{{ ai_gen_id }}__page{padding:32px 18px}.psc-guide-{{ ai_gen_id }}__cover-grid,.psc-guide-{{ ai_gen_id }}__step{grid-template-columns:1fr}}@media print{.psc-guide-{{ ai_gen_id }}__toolbar{display:none!important}.psc-guide-{{ ai_gen_id }}__page,.psc-guide-{{ ai_gen_id }}__section,.psc-guide-{{ ai_gen_id }}__step{page-break-before:always}.psc-guide-{{ ai_gen_id }}{width:100%}}{% endstyle %}<psc-install-guide-{{ ai_gen_id }} class="psc-guide-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="psc-guide-{{ ai_gen_id }}__toolbar"><button class="psc-guide-{{ ai_gen_id }}__print" type="button">Print Guide</button></div><div class="psc-guide-{{ ai_gen_id }}__page"><img class="psc-guide-{{ ai_gen_id }}__logo" src="{% if block.settings.logo %}{{ block.settings.logo | image_url: width: 500 }}{% endif %}" alt="PSC Motorsports"><div class="psc-guide-{{ ai_gen_id }}__eyebrow">{{ block.settings.guide_category }}</div><div class="psc-guide-{{ ai_gen_id }}__cover-grid"><div class="psc-guide-{{ ai_gen_id }}__kit">{% if block.settings.kit_image %}<img src="{{ block.settings.kit_image | image_url: width: 1000 }}" alt="{{ block.settings.kit_image.alt | escape }}">{% else %}Add the kit image{% endif %}</div><div><h1 class="psc-guide-{{ ai_gen_id }}__title">{{ block.settings.product_title }}</h1><p class="psc-guide-{{ ai_gen_id }}__application">{{ block.settings.product_application }}</p><p class="psc-guide-{{ ai_gen_id }}__year">{{ block.settings.product_year }}</p><ul class="psc-guide-{{ ai_gen_id }}__parts">{% assign parts=block.settings.part_numbers | newline_to_br | split:'<br />' %}{% for part in parts %}<li>{{ part }}</li>{% endfor %}</ul></div></div><div class="psc-guide-{{ ai_gen_id }}__cover-label">INSTALLATION GUIDE</div></div>{% assign names='Table of Contents|Before You Get Started|What’s in the Kit' | split:'|' %}{% assign content=block.settings.table_of_contents | append:'||' | append:block.settings.before_you_get_started | append:'||' | append:block.settings.whats_in_the_kit | split:'||' %}{% for name in names %}<section class="psc-guide-{{ ai_gen_id }}__page psc-guide-{{ ai_gen_id }}__section"><div class="psc-guide-{{ ai_gen_id }}__band"><img src="{% if block.settings.logo %}{{ block.settings.logo | image_url: width: 300 }}{% endif %}" alt=""><h2>{{ name }}</h2></div><div class="psc-guide-{{ ai_gen_id }}__content">{{ content[forloop.index0] }}</div></section>{% endfor %}<section class="psc-guide-{{ ai_gen_id }}__page psc-guide-{{ ai_gen_id }}__section"><div class="psc-guide-{{ ai_gen_id }}__band"><h2>Contact Us</h2></div><div class="psc-guide-{{ ai_gen_id }}__content"><h3>{{ block.settings.contact_subheading }}</h3><p>{{ block.settings.contact_phone }}</p><p>{{ block.settings.contact_hours }}</p><p>{{ block.settings.contact_email }}</p><p>{{ block.settings.contact_website }}</p></div></section></psc-install-guide-{{ ai_gen_id }}><script>(function(){class PSCGuide{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.querySelector('button').addEventListener('click',function(){window.print()})}}customElements.define('psc-install-guide-{{ ai_gen_id }}',PSCGuide{{ ai_gen_id }})})();</script>{% schema %}{"name":"PSC installation guide","tag":null,"class":"psc-installation-guide","settings":[{"type":"image_picker","id":"logo","label":"PSC logo"},{"type":"text","id":"guide_category","label":"Guide category","default":"Performance steering systems"},{"type":"text","id":"product_title","label":"Product title","default":"Installation guide"},{"type":"text","id":"product_application","label":"Product application","default":"Vehicle application"},{"type":"text","id":"product_year","label":"Product year","default":"Model year"},{"type":"textarea","id":"part_numbers","label":"Part numbers","default":"Enter part number"},{"type":"image_picker","id":"kit_image","label":"Kit image"},{"type":"richtext","id":"table_of_contents","label":"Table of contents","default":"<p>Add the guide contents here.</p>"},{"type":"richtext","id":"before_you_get_started","label":"Before you get started","default":"<p>Add preparation and safety information here.</p>"},{"type":"richtext","id":"whats_in_the_kit","label":"What’s in the kit","default":"<p>List kit contents here.</p>"},{"type":"text","id":"contact_subheading","label":"Contact subheading","default":"Need technical support?"},{"type":"text","id":"contact_phone","label":"Contact phone","default":"Phone: Add phone number"},{"type":"text","id":"contact_hours","label":"Contact hours","default":"Hours: Add support hours"},{"type":"text","id":"contact_email","label":"Contact email","default":"Email: Add email address"},{"type":"text","id":"contact_website","label":"Contact website","default":"Website: www.pscsteering.com"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"PSC installation guide"}]}{% endschema %}