{% doc %}
  @prompt
    <div class="install-guide">
    
      <!-- Cover Page -->
      <div class="install-guide-cover">
    
        <div class="install-guide-cover__image">
          {% if section.settings.cover_image %}
            {{
              section.settings.cover_image
              | image_url: width: 1200
              | image_tag
            }}
          {% endif %}
        </div>
    
        <div class="install-guide-cover__info">
    
          <h1>{{ section.settings.product_title }}</h1>
    
          {% if section.settings.application != blank %}
            <div class="guide-meta">
              <strong>Application:</strong>
              {{ section.settings.application }}
            </div>
          {% endif %}
    
          {% if section.settings.year_range != blank %}
            <div class="guide-meta">
              <strong>Years:</strong>
              {{ section.settings.year_range }}
            </div>
          {% endif %}
    
          {% if section.settings.part_number != blank %}
            <div class="guide-meta">
              <strong>Part Number:</strong>
              {{ section.settings.part_number }}
            </div>
          {% endif %}
    
        </div>
    
      </div>
    
      <!-- Steps -->
      <div class="install-guide-steps">
    
        {% for block in section.blocks %}
    
          <div class="install-step" {{ block.shopify_attributes }}>
    
            <div class="install-step-number">
              Step {{ forloop.index }}
            </div>
    
            <h2>{{ block.settings.title }}</h2>
    
            {% if block.settings.image %}
              <div class="install-step-image">
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag
                }}
              </div>
            {% endif %}
    
            <div class="install-step-content">
              {{ block.settings.instructions }}
            </div>
    
          </div>
    
        {% endfor %}
    
      </div>
    
    </div>
    
    <style>
    
    .install-guide {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 20px;
    }
    
    .install-guide-cover {
      display: grid;
      grid-template-columns: 45% 55%;
      gap: 40px;
      align-items: center;
      margin-bottom: 60px;
      padding-bottom: 40px;
      border-bottom: 2px solid #e5e5e5;
    }
    
    .install-guide-cover__image img {
      width: 100%;
      height: auto;
      display: block;
    }
    
    .install-guide-cover__info h1 {
      font-size: 42px;
      margin-bottom: 25px;
    }
    
    .guide-meta {
      font-size: 18px;
      margin-bottom: 12px;
    }
    
    .install-step {
      margin-bottom: 80px;
    }
    
    .install-step-number {
      display: inline-block;
      background: #d71920;
      color: #fff;
      padding: 8px 18px;
      font-weight: 700;
      margin-bottom: 15px;
    }
    
    .install-step h2 {
      margin-bottom: 20px;
    }
    
    .install-step-image {
      margin-bottom: 25px;
    }
    
    .install-step-image img {
      width: 100%;
      height: auto;
    }
    
    .install-step-content {
      font-size: 16px;
      line-height: 1.7;
    }
    
    @media screen and (max-width: 768px) {
    
      .install-guide-cover {
        grid-template-columns: 1fr;
      }
    
      .install-guide-cover__info h1 {
        font-size: 30px;
      }
    
    }
    
    </style>
    
    {% schema %}
    {
      "name": "Install Guide",
      "settings": [
        {
          "type": "image_picker",
          "id": "cover_image",
          "label": "Cover Image"
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Product Title"
        },
        {
          "type": "text",
          "id": "application",
          "label": "Application"
        },
        {
          "type": "text",
          "id": "year_range",
          "label": "Year Range"
        },
        {
          "type": "text",
          "id": "part_number",
          "label": "Part Number"
        }
      ],
      "blocks": [
        {
          "type": "step",
          "name": "Installation Step",
          "settings": [
            {
              "type": "text",
              "id": "title",
              "label": "Step Title"
            },
            {
              "type": "image_picker",
              "id": "image",
              "label": "Step Image"
            },
            {
              "type": "richtext",
              "id": "instructions",
              "label": "Instructions"
            }
          ]
        }
      ],
      "presets": [
        {
          "name": "Install Guide"
        }
      ]
    }
    {% endschema %}
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-install-guide-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px 20px;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    font-family: {{ block.settings.body_font.family }};
  }

  .ai-install-guide-{{ ai_gen_id }} * {
    box-sizing: border-box;
  }

  .ai-install-guide-{{ ai_gen_id }}__cover {
    display: grid;
    grid-template-columns: minmax(0, 45%) minmax(0, 55%);
    gap: 40px;
    align-items: center;
    margin: 0 auto 56px;
    padding-bottom: 40px;
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-install-guide-{{ ai_gen_id }}__cover-image,
  .ai-install-guide-{{ ai_gen_id }}__step-image {
    overflow: hidden;
    background: {{ block.settings.image_placeholder_color }};
  }

  .ai-install-guide-{{ ai_gen_id }}__cover-image img,
  .ai-install-guide-{{ ai_gen_id }}__step-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .ai-install-guide-{{ ai_gen_id }}__placeholder {
    display: flex;
    min-height: 220px;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.muted_text_color }};
  }

  .ai-install-guide-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    max-width: 260px;
    max-height: 220px;
  }

  .ai-install-guide-{{ ai_gen_id }}__cover-info h2,
  .ai-install-guide-{{ ai_gen_id }}__step h3 {
    margin: 0 0 18px;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }};
    font-weight: 700;
  }

  .ai-install-guide-{{ ai_gen_id }}__cover-info h2 {
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.08;
  }

  .ai-install-guide-{{ ai_gen_id }}__meta {
    margin: 0 0 10px;
    font-size: 18px;
    line-height: 1.45;
  }

  .ai-install-guide-{{ ai_gen_id }}__meta strong {
    color: {{ block.settings.heading_color }};
  }

  .ai-install-guide-{{ ai_gen_id }}__step {
    margin-bottom: 64px;
  }

  .ai-install-guide-{{ ai_gen_id }}__step:last-child {
    margin-bottom: 0;
  }

  .ai-install-guide-{{ ai_gen_id }}__number {
    display: inline-block;
    margin-bottom: 16px;
    padding: 8px 16px;
    background: {{ block.settings.accent_color }};
    color: {{ block.settings.accent_text_color }};
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .ai-install-guide-{{ ai_gen_id }}__step h3 {
    font-size: 28px;
    line-height: 1.2;
  }

  .ai-install-guide-{{ ai_gen_id }}__step-image {
    margin-bottom: 22px;
  }

  .ai-install-guide-{{ ai_gen_id }}__content {
    font-size: 17px;
    line-height: 1.7;
  }

  .ai-install-guide-{{ ai_gen_id }}__content p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-install-guide-{{ ai_gen_id }} {
      padding-right: 16px;
      padding-left: 16px;
    }

    .ai-install-guide-{{ ai_gen_id }}__cover {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-bottom: 40px;
      padding-bottom: 28px;
    }

    .ai-install-guide-{{ ai_gen_id }}__meta {
      font-size: 16px;
    }
  }
{% endstyle %}

<div class="ai-install-guide-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-install-guide-{{ ai_gen_id }}__cover">
    <div class="ai-install-guide-{{ ai_gen_id }}__cover-image">
      {% if block.settings.cover_image %}
        {{ block.settings.cover_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: block.settings.product_title }}
      {% else %}
        <div class="ai-install-guide-{{ ai_gen_id }}__placeholder">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
    <div class="ai-install-guide-{{ ai_gen_id }}__cover-info">
      <h2>{{ block.settings.product_title }}</h2>
      {% if block.settings.application != blank %}<p class="ai-install-guide-{{ ai_gen_id }}__meta"><strong>Application:</strong> {{ block.settings.application }}</p>{% endif %}
      {% if block.settings.year_range != blank %}<p class="ai-install-guide-{{ ai_gen_id }}__meta"><strong>Years:</strong> {{ block.settings.year_range }}</p>{% endif %}
      {% if block.settings.part_number != blank %}<p class="ai-install-guide-{{ ai_gen_id }}__meta"><strong>Part number:</strong> {{ block.settings.part_number }}</p>{% endif %}
    </div>
  </div>

  {% for i in (1..3) %}
    {% liquid
      assign title_key = 'step_' | append: i | append: '_title'
      assign image_key = 'step_' | append: i | append: '_image'
      assign instructions_key = 'step_' | append: i | append: '_instructions'
      assign step_title = block.settings[title_key]
      assign step_image = block.settings[image_key]
      assign step_instructions = block.settings[instructions_key]
    %}
    {% if step_title != blank or step_instructions != blank or step_image %}
      <article class="ai-install-guide-{{ ai_gen_id }}__step">
        <div class="ai-install-guide-{{ ai_gen_id }}__number">Step {{ i }}</div>
        {% if step_title != blank %}<h3>{{ step_title }}</h3>{% endif %}
        {% if step_image %}
          <div class="ai-install-guide-{{ ai_gen_id }}__step-image">{{ step_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: step_title }}</div>
        {% endif %}
        {% if step_instructions != blank %}<div class="ai-install-guide-{{ ai_gen_id }}__content">{{ step_instructions }}</div>{% endif %}
      </article>
    {% endif %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "Install guide",
  "settings": [
    { "type": "header", "content": "Guide" },
    { "type": "image_picker", "id": "cover_image", "label": "Cover image" },
    { "type": "text", "id": "product_title", "label": "Product title", "default": "Installation guide" },
    { "type": "text", "id": "application", "label": "Application" },
    { "type": "text", "id": "year_range", "label": "Year range" },
    { "type": "text", "id": "part_number", "label": "Part number" },
    { "type": "header", "content": "Step 1" },
    { "type": "text", "id": "step_1_title", "label": "Title", "default": "Prepare for installation" },
    { "type": "image_picker", "id": "step_1_image", "label": "Image" },
    { "type": "richtext", "id": "step_1_instructions", "label": "Instructions", "default": "<p>Review the included parts and installation requirements before beginning.</p>" },
    { "type": "header", "content": "Step 2" },
    { "type": "text", "id": "step_2_title", "label": "Title", "default": "Install the component" },
    { "type": "image_picker", "id": "step_2_image", "label": "Image" },
    { "type": "richtext", "id": "step_2_instructions", "label": "Instructions", "default": "<p>Follow the vehicle-specific installation instructions and verify each connection.</p>" },
    { "type": "header", "content": "Step 3" },
    { "type": "text", "id": "step_3_title", "label": "Title", "default": "Inspect and test" },
    { "type": "image_picker", "id": "step_3_image", "label": "Image" },
    { "type": "richtext", "id": "step_3_instructions", "label": "Instructions", "default": "<p>Inspect the completed installation and test the system before driving.</p>" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "vertical_padding", "label": "Vertical padding", "min": 0, "max": 80, "step": 5, "unit": "px", "default": 40 },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "barlow_condensed_n4" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "barlow_condensed_n4" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#121212" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#D6001C" },
    { "type": "color", "id": "accent_text_color", "label": "Accent text", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Divider", "default": "#E5E5E5" },
    { "type": "color", "id": "image_placeholder_color", "label": "Image placeholder", "default": "#F4F4F4" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text", "default": "#5A5A5A" }
  ],
  "presets": [{ "name": "Install guide" }],
  "tag": null,
  "class": "install-guide-block"
}
{% endschema %}