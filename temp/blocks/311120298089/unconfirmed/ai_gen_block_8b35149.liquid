    {"type":"text","id":"guide_4_title","label":"Guide 4 title"},{"type":"text","id":"guide_4_vehicle","label":"Guide 4 vehicle"},{"type":"text","id":"guide_4_category","label":"Guide 4 category"},{"type":"url","id":"guide_4_pdf","label":"Guide 4 PDF"},
    {"type":"text","id":"guide_5_title","label":"Guide 5 title"},{"type":"text","id":"guide_5_vehicle","label":"Guide 5 vehicle"},{"type":"text","id":"guide_5_category","label":"Guide 5 category"},{"type":"url","id":"guide_5_pdf","label":"Guide 5 PDF"},
    {"type":"text","id":"guide_6_title","label":"Guide 6 title"},{"type":"text","id":"guide_6_vehicle","label":"Guide 6 vehicle"},{"type":"text","id":"guide_6_category","label":"Guide 6 category"},{"type":"url","id":"guide_6_pdf","label":"Guide 6 PDF"},
    {"type":"header","content":"Tech videos"},
    {"type":"text","id":"video_1_title","label":"Video 1 title"},{"type":"url","id":"video_1_url","label":"Video 1 link"},{"type":"text","id":"video_2_title","label":"Video 2 title"},{"type":"url","id":"video_2_url","label":"Video 2 link"},{"type":"text","id":"video_3_title","label":"Video 3 title"},{"type":"url","id":"video_3_url","label":"Video 3 link"},
    {"type":"header","content":"Troubleshooting articles"},
    {"type":"text","id":"article_1_title","label":"Article 1 title"},{"type":"url","id":"article_1_url","label":"Article 1 link"},{"type":"text","id":"article_2_title","label":"Article 2 title"},{"type":"url","id":"article_2_url","label":"Article 2 link"},{"type":"text","id":"article_3_title","label":"Article 3 title"},{"type":"url","id":"article_3_url","label":"Article 3 link"},
    {"type":"header","content":"Tech support"},
    {"type":"textarea","id":"support_copy","label":"Support information"},{"type":"text","id":"support_email","label":"Support email"},{"type":"text","id":"support_phone","label":"Support phone"}
