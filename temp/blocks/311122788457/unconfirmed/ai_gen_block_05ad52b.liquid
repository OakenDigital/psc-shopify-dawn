{% doc %}
  @prompt
    Create an editable table block for the currently selected psc-install-guides page template. The table must have exactly 5 columns and 21 editable body rows, plus a separate editable header row. Make all five column headings and every cell editable in the theme editor. Match the existing PSC Motorsports theme typography and colors, with clear header styling, subtle row borders, consistent padding, and accessible table semantics. On mobile, keep the table readable using horizontal scrolling within the table container, without making the whole page overflow. Do not invent guide titles, product information, or links; leave cell content empty for the merchant to populate. Add only this table and preserve all existing page content. Do not change the About Us page's content or template assignment; it is currently only being used to preview psc-install-guides.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-install-table-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: rgb(var(--color-foreground));
    font-family: var(--font-body-family);
    font-size: 1.5rem;
  }

  .ai-install-table__scroll-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid rgba(var(--color-foreground), 0.18);
  }

  .ai-install-table__table-{{ ai_gen_id }} {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    table-layout: fixed;
    text-align: left;
  }

  .ai-install-table__table-{{ ai_gen_id }} th,
  .ai-install-table__table-{{ ai_gen_id }} td {
    padding: 12px 14px;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.16);
    border-right: 1px solid rgba(var(--color-foreground), 0.12);
    vertical-align: top;
    overflow-wrap: anywhere;
  }

  .ai-install-table__table-{{ ai_gen_id }} th:last-child,
  .ai-install-table__table-{{ ai_gen_id }} td:last-child {
    border-right: 0;
  }

  .ai-install-table__table-{{ ai_gen_id }} thead th {
    background: #2d2926;
    color: #ffffff;
    font-weight: 700;
    border-bottom: 2px solid #d6001c;
  }

  .ai-install-table__table-{{ ai_gen_id }} tbody tr:last-child td {
    border-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-install-table-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-install-table-{{ ai_gen_id }}" style="width: {{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  <div class="ai-install-table__scroll-{{ ai_gen_id }}" role="region" aria-label="Scrollable table" tabindex="0">
    <table class="ai-install-table__table-{{ ai_gen_id }}">
      <thead>
        <tr>
          <th scope="col">{{ block.settings.head_1 | escape }}</th>
          <th scope="col">{{ block.settings.head_2 | escape }}</th>
          <th scope="col">{{ block.settings.head_3 | escape }}</th>
          <th scope="col">{{ block.settings.head_4 | escape }}</th>
          <th scope="col">{{ block.settings.head_5 | escape }}</th>
        </tr>
      </thead>
      <tbody>
        {% for row in (1..21) %}
          <tr>
            {% for col in (1..5) %}
              {% assign cell_key = 'r' | append: row | append: '_c' | append: col %}
              <td>{{ block.settings[cell_key] | escape }}</td>
            {% endfor %}
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

