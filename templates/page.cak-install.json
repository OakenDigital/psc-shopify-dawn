        "kit_category_ewdDUK": {
          "type": "kit_category",
          "settings": {
            "header": "Safety & Prep",
            "body": "<ul><li>Park on level ground and set the parking brake.</li><li>Center the steering wheel and secure it so it cannot rotate during installation. A ratchet strap around the wheel works well.</li><li>Use jack stands. Never rely on a jack alone.</li><li>Wear eye protection and gloves.</li><li>Before disconnecting any hoses, verify the engine is off and the steering system is not under pressure. Place a drain pan beneath the work area to catch any fluid released when the hoses are disconnected.</li><li>Keep hydraulic fluid handy for topping off after install.</li></ul>"
          }
        },
