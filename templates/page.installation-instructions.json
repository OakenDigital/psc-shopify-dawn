    "psc_installation_guide_AA4Nef": {
      "type": "psc-installation-guide",
      "blocks": {
        "toc_entry_RQkR4C": {
          "type": "toc_entry",
          "settings": {
            "title": "Before you get started",
            "range": "",
            "items": "<ul><li>Tools and safety</li></ul>"
          }
        },
        "toc_entry_TLHLWC": {
          "type": "toc_entry",
          "settings": {
            "title": "What's in the kit",
            "range": "",
            "items": "<ul><li>Included components</li><li>Tools Needed</li></ul>"
          }
        },
        "toc_entry_MFPXmD": {
          "type": "toc_entry",
          "settings": {
            "title": "Installation",
            "range": "",
            "items": "<ul><li>Installation</li><li>VVT Solenoid Adjustment</li><li>A/C Bracket (Only for ADK‑LT100)</li><li>Water Pump & Adapter Plates</li><li>Power Steering Brackets & Pump</li><li>Alternator Brackets & Tensioner</li><li>Belt Install</li><li>Final Checks</li></ul>"
          }
        },
        "toc_entry_YtUPLL": {
          "type": "toc_entry",
          "settings": {
            "title": "Contact us",
            "range": "",
            "items": "<ul><li>Technical support</li></ul>"
          }
        },
        "kit_category_JbpLyq": {
          "type": "kit_category",
          "settings": {
            "header": "Brackets",
            "body": "<p>• (1) 12.21A — Alternator Mounting Bracket (Front)<br/>• (1) 12.21B — Alternator Mounting Bracket (Rear)<br/>• (1) 12.22LH — Driver-Side Water Pump Adapter<br/>• (1) 12.22RH — Passenger-Side Water Pump Adapter Bracket (Temperature Sensor Port)<br/>• (1) 12.23 — Idler Pulley Bracket<br/><br/></p>"
          }
        },
        "kit_category_YcM36D": {
          "type": "kit_category",
          "settings": {
            "header": "Components",
            "body": "<p>• (1) TNR-100K — Belt Tensioner<br/>• (1) BT60845 — 6-Rib Serpentine Belt, 84.5”<br/>• (2) GK-LT1WP — Water Pump Gaskets<br/>• Required mounting hardware and fasteners<br/><br/></p>"
          }
        },
        "kit_category_gmYbYG": {
          "type": "kit_category",
          "settings": {
            "header": "Power Steering Pump",
            "body": "<p>One of the following pumps is included depending on kit purchased:</p><ul><li>SP33332S-3608 — LHD CBR Pump (-6 AN Pressure, -12 AN Feed)<br/></li><li>SP32232-3608 — RHD CBR Pump (-6 AN Pressure, -12 AN Feed)</li></ul>"
          }
        },
        "kit_category_whAfV7": {
          "type": "kit_category",
          "settings": {
            "header": "ADK-LT100G & ADK-LT100R Only",
            "body": "<p>• (1) 12.20 — A/C Mounting Bracket<br/>• Associated hardware and fasteners</p>"
          }
        },
        "kit_category_H9LMjn": {
          "type": "kit_category",
          "settings": {
            "header": "Spacer Inventory",
            "body": "<p>• (1) 15.103 Spacer, 2.015”<br/>• (1) 15.203 Spacer, 0.950”<br/>• (3) 15.112 Spacers, 0.875”</p>"
          }
        },
        "kit_category_LiT3Mi": {
          "type": "kit_category",
          "settings": {
            "header": "Applicable Kits",
            "body": "<p>This installation guide applies to the following PSC Accessory Drive Conversion Kits:</p><p><br/>• ADK-LT100G<br/>• ADK-LT100R<br/>• ADK-LT101G<br/>• ADK-LT101R</p><p><br/>Note: ADK-LT100 Series kits include the A/C mounting bracket. ADK-LT101 Series kits<br/>do not include the A/C mounting bracket. Contents may vary slightly </p>"
          }
        },
        "kit_category_66x9Jy": {
          "type": "kit_category",
          "settings": {
            "header": "Tools Needed",
            "body": "<p>• Basic hand tools<br/>• Hex/Allen key socket set<br/>• Thread sealant<br/>• Drain pan/ rags<br/>• M10 1.5 bottom end tap<br/>• M8 1.25 bottom end tap</p><p><br/>Use medium strength thread locker on all bolts unless the bolt uses a lock nut.<br/><br/></p>"
          }
        },
        "step_K6k3PQ": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "STEP",
            "label": "Prep the Engine",
            "body": "<ul><li><em>Disconnect the battery</em></li><li><em>Drain the coolant</em></li></ul>"
          }
        },
        "step_p4UDTU": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "STEP",
            "label": "Strip the Front of the Engine",
            "body": "<p><strong>Remove and discard:</strong></p><ul><li>All factory belts</li><li>Factory accessory brackets</li><li>Factory accessories</li><li>OEM water pump and housing </li></ul><p><strong>Remove and retain for installation:</strong></p><ul><li>Alternator</li><li>A/C compressor</li><li>If your A/C uses a stretch belt, OEMs recommend replacing it.</li></ul>",
            "image_1": "shopify://shop_images/ADK-LT100_Pic_1.jpg"
          }
        },
        "step_mPKCht": {
          "type": "step",
          "settings": {
            "image_position": "left",
            "header": "STEP",
            "label": "Remove the VVT Solenoid",
            "body": "<p>Disconnect the electrical connector, then remove and retain the three mounting bolts.</p>",
            "image_1": "shopify://shop_images/ADK-LT100_Pic_3.jpg"
          }
        },
        "step_Ti9JPh": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "STEP",
            "label": "Rotate and Modify",
            "body": "<p>Rotate the VVT solenoid counterclockwise one mounting position so the electrical connector is positioned behind the crank pulley. Loosely reinstall two bolts to hold.</p><p><strong>Mark the VVT solenoid at the third bolt hole. Then remove and modify using a small angle grinder.</strong></p><p><strong>NOTE: </strong>Be careful not to damage the O-ring on the VVT solenoid during removal or modification.</p>",
            "image_1": "shopify://shop_images/ADK-LT100_Pic_5-1.jpg"
          }
        },
        "step_g4dyXM": {
          "type": "step",
          "settings": {
            "image_position": "left",
            "header": "STEP",
            "label": "Reinstall the Solenoid",
            "body": "<p>Reinstall the VVT solenoid using the factory bolts and reconnect the electrical connector. Torque the bolts to 9 lb-ft.<br/>Secure the wiring harness to an adjacent factory harness or bracket using zip ties, making sure it cannot contact the crank damper, pulley, or belt.<br/><br/></p>",
            "image_1": "shopify://shop_images/ADK-LT100_Pic_9.jpg"
          }
        },
        "step_xkAxXJ": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "A/C Bracket NOTE: If you’re using ADK LT101, skip to Step 9.",
            "label": "Install the A/C Bracket (12.20)",
            "body": "<p>Use:</p><ul><li>(1) M8 1.25 x 75 mm bolt + washer (middle  hole)</li><li>Leave it loose for now.<br/></li></ul>",
            "image_1": "shopify://shop_images/ADK-LT100_Pic_12.jpg"
          }
        },
        "step_Mw8NCM": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "STEP",
            "label": "Install the A/C Compressor",
            "body": "<p>Install the A/C compressor using:</p><ul><li>1) M8 1.25 x 150 mm bolt and flat washer (upper mounting hole)</li><li>(1) M8 1.25 x 90 mm bolt and flat washer (lower mounting hole)</li></ul><p>Apply Loctite to the bolt threads and tighten all three mounting bolts securely. Reinstall the A/C stretch belt if it is in good condition, or replace it with a new belt.</p><p><br/><strong>Note</strong>: A/C stretch belt manufacturers recommend replacing the belt once removed. Use a stretch belt installation tool or an approved zip-tie installation method. Do not use a screwdriver, pry bar or similar tool to force the belt onto the pulley, as damage to the belt may result.<br/></p>",
            "image_1": "shopify://shop_images/ADK-LT100_Pic_15.jpg"
          }
        },
        "step_V3gA8w": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "STEP",
            "label": "Install the Water Pump and Adapters",
            "body": "<p>Using a 6MM hex socket. Install the water pump with the 12.22 RH and 12.22 LH adapters using six (6) M8‑1.25 x 130 mm socket head bolts with flat washers. Loosely install the top two (2) driver-side bolts and torque the rest to 30 lb-ft<br/>The driver-side adapter (12.22 RH) has the temperature sensor port.<br/>After securing the pump, install the temperature sensor.<br/><strong>Tip:</strong> To make installation easier, apply a few drops of gasket adhesive to hold the gaskets in place while positioning the water pump assembly.</p>",
            "image_1": "shopify://shop_images/ADK-LT100_Pic_13.jpg",
            "image_3": "shopify://shop_images/ADK-LT100_Pic_19.jpg"
          }
        },
        "step_ffDf7T": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "STEP",
            "label": "Install the 12.19 Pump Bracket",
            "body": "<p>Driver side cylinder head →<br/>Use:</p><ul><li>(1) 8 mm hex socket</li><li>(3) M10 1.5 x 45 mm bolts</li><li>(3) 15.112 spacers between the head and the bracket.</li></ul><p>Torque the bolts to 55 lb-ft.</p>",
            "image_1": "shopify://shop_images/ADK-LT100_Pic_21.jpg"
          }
        },
        "step_qHpddh": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "STEP",
            "label": "Install the 12.23 Idler Bracket",
            "body": "<p>Remove the two driver side upper water pump bolts <br/>Loosely mount the 12.23 idler bracket.<br/></p>",
            "image_1": "shopify://shop_images/ADK-LT100_Pic_24.jpg"
          }
        },
        "step_Y3Vxd7": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "STEP",
            "label": "Install the Power Steering Pump",
            "body": "<p>Between the 12.19 and 12.23 brackets:<br/>Use:</p><ul><li>(1) 5/16 18 x 3.5” + washer (top hole)</li><li>(1) 5/16 18 x 3” + washer (bottom hole)</li><li>(1) M8 1.25 x 30 mm flange bolt (inner hole)</li></ul><p>Once the pump is properly positioned, tighten all pump mounting hardware evenly. Torque 8mm bolts to 30 lb-ft and the 5/16 bolts to 25 lb-ft.<br/><br/><br/><br/><br/><br/></p>",
            "image_1": "shopify://shop_images/ADK-LT100_pump.jpg"
          }
        },
        "step_kNUzab": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "STEP",
            "label": "Assemble and Install the Idler Pulley",
            "body": "<p>Use:</p><ul><li>PP4103 idler pulley to the 12.23 bracket.</li><li>15.203 spacer (between pulley and bracket)</li><li>(1) M10 1.5 x 50 mm bolt</li><li>Heavy duty washer</li><li>Lock nut</li></ul><p><strong>NOTE:</strong> Snap ring faces forward.</p>",
            "image_1": "shopify://shop_images/ADK-LT100_Pic_34.jpg"
          }
        },
        "step_8XM3YY": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "STEP",
            "label": "Install the 12.21B Bracket (Rear)",
            "body": "<p>Passenger side cylinder head →<br/>Loosely install:</p><ul><li>(1) M10 1.5 x 35 mm flange bolt</li><li>(1) M8 1.25 x 35 mm flange bolt</li></ul><p>Don’t tighten yet.<br/></p>",
            "image_1": "shopify://shop_images/ADK-LT100_Pic_35.jpg"
          }
        },
        "step_cHqj7f": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "STEP",
            "label": "Install the 12.21A Bracket (Front Alternator Bracket)",
            "body": "<p>Mount it to the water pump bosses using an 8 mm hex socket:</p><ul><li>(2) M10 1.5 x 45 mm bolts</li><li>Torque to 55 lb-ft</li></ul>",
            "image_1": "shopify://shop_images/ADK-LT100_Pic_37.jpg"
          }
        },
        "step_byGprp": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "STEP",
            "label": "Install the Alternator",
            "body": "<p>Use:</p><ul><li>(1) M10 1.5 x 130 mm bolt through 12.21A → alternator → 15.103 spacer → into 12.21B</li><li>(1) M10 1.5 x 70 mm bolt + lock nut (inner hole)</li></ul><p>Tighten alternator bolts first, then tighten the 12.21B hardware from Step 14. Torque the M10 bolts to 55 lb-ft and the M8 bolt to 30 lb-ft.<br/></p>",
            "image_1": "shopify://shop_images/ADK-LT100_Pic_39.jpg"
          }
        },
        "step_rhGMA9": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "STEP",
            "label": "Prepare the vehicle",
            "body": "<ul><li>Disconnect the battery and secure the vehicle.</li></ul>"
          }
        },
        "step_CeQMB4": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "STEP",
            "label": "Prepare the vehicle",
            "body": "<ul><li>Disconnect the battery and secure the vehicle.</li></ul>"
          }
        },
        "step_e66zbV": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "STEP",
            "label": "Prepare the vehicle",
            "body": "<ul><li>Disconnect the battery and secure the vehicle.</li></ul>"
          }
        }
      },
