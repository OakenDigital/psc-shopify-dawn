          "settings": {
            "logo_width": 140,
            "guide_part_name": "Accessory Drive Conversion Kits",
            "guide_title": "GM Gen 5 LT Engine",
            "year": "2014+",
            "part_numbers": "Part #: ADK-LT100",
            "table_contents": "<p><strong>01 — BEFORE YOU GET STARTED</strong></p><ul><li>Important information</li></ul><p><strong>02 — WHAT'S IN THE KIT</strong></p><ul><li>Parts and components</li></ul><p><strong>03 — INSTALLATION</strong></p><ul><li>Step-by-step instructions</li></ul>",
            "before_started": "<p>Read all instructions before beginning installation. Verify that all parts are present and consult a qualified technician if needed.</p>",
            "kit_contents": "<h3>BRACKETS</h3><ul><li>Part number — Description</li></ul><h3>COMPONENTS</h3><ul><li>Part number — Description</li></ul><h3>POWER STEERING PUMP</h3><ul><li>Part number — Description</li></ul>",
            "step_1_label": "Prepare the vehicle",
            "step_1_text": "<ul><li>Disconnect the battery.</li><li>Confirm the work area is clean.</li></ul>",
            "step_2_label": "Remove existing components",
