        "step_R7WyNe": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "STEP",
            "label": "",
            "body": "<p>Using the <strong>OEM </strong>bolts you saved from the grille brace, <strong>mount the cooler/bracket assembly</strong> to the grille <strong>in place of the removed center brace.</strong></p>",
