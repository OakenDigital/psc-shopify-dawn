        "step_qHpddh": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "STEP",
            "label": "Clearance the OEM pump bracket",
            "body": "<p>Clearance the OEM pump bracket</p><ul><li>Take a little at a time, test fit, and deburr your cut.</li><li>Take a little at a time, test fit, and deburr your cut.<br/></li></ul>",
            "image_1": "shopify://shop_images/step-10.png",
