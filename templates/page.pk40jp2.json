        "kit_category_YcM36D": {
          "type": "kit_category",
          "settings": {
            "header": "{{ page.metafields.custom.instructions_included_header_2.value }}Parts",
            "body": "<ul><li>SRK-6-12-P — Remote Reservoir Fitting Kit (-6 AN / -12 AN AUX plug)</li><li>HA-L138 — Feed Hose (Reservoir → Pump)</li><li>SR146 — Remote Reservoir</li><li>SR-VT — Anti-Splash Pressure Relief Valve</li><li>CK215 — Heat Sink Cooler Kit (complete assembly)</li><li>SP33362SJP — Power Steering Pump</li><li>HE80293 — High Pressure Hose Kit</li><li>MR20K — Reservoir Mount Kit</li><li>FL-SWE715-4PAK — Fluid (4 quarts)</li></ul>"
          }
        },
        "kit_category_whAfV7": {
          "type": "kit_category",
          "settings": {
            "header": "{{ page.metafields.custom.instructions_included_header_4.value }}Tools Needed",
            "body": "<p><strong>Hand Tools:</strong></p><ul><li>Standard SAE/metric socket set</li><li>Combination wrenches (SAE/metric)</li><li>Ratchet with extensions</li><li>Line wrenches for hydraulic fittings</li><li>Torque wrench (for accessory belt tension and general hardware)</li><li>Breaker bar (for belt tensioner if needed</li></ul><p><strong>Cutting & Finishing Tools:</strong></p><ul><li>Sharp utility knife (for condenser seal trimming)</li><li>Small file or deburring tool (for cleaning up the pump bracket)</li><li>Marker/paint pen (for alignment marks)</li></ul><p><strong>Cooling/Front Clip Handling:</strong></p><ul><li>Screwdrivers (flat and Phillips)</li><li>Needle nose pliers</li><li>Trim tool (helpful but optional)</li></ul><p><strong>Fluids & Safety:</strong></p><ul><li>Drain pan for power steering fluid</li><li>Clean rags or shop towels</li><li>Gloves and safety glasses</li></ul><p><strong>Helpful but Optional:</strong></p><ul><li>Shop light</li><li>Zip ties for hose management</li><li>AN wrench/spanner (keeps aluminum fittings clean)<br/></li></ul>"
          }
        },
        "kit_category_iMq7aX": {
          "type": "kit_category",
          "settings": {
            "header": "Safety & Prep",
            "body": "<ul><li>Park on level ground. Let the Jeep cool down.</li><li>Disconnect the battery.</li><li>You’ll be trimming the condenser seal and slightly clearancing&nbsp;the pump bracket— have a sharp utility knife and a file handy.</li><li>Use PSC 715 fluid only.<br/><br/></li></ul>"
          }
        },
