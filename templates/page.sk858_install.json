        "kit_category_JbpLyq": {
          "type": "kit_category",
          "settings": {
            "header": "Box 1",
            "body": "<ul><li>SG856R— Cylinder Assist Steering Gear</li></ul>"
          }
        },
        "kit_category_YcM36D": {
          "type": "kit_category",
          "settings": {
            "header": "Box 2 — CAK858",
            "body": "<ul><li>(1) SC2200 – Cylinder Assist® – Single-Ended – 1.5” x 8.0”</li><li>(1) MB34K – Mounting Bracket – Cylinder Assist® – Ram 2500/3500 (2019–2021)</li><li>(1) HK2062 – Hose Kit – Ram 2500/3500 Cylinder Assist® (2014+)</li><li>(1) REXFR10 – Rod End – Female Shank – RH Thread – 5/8-18 FR x 5/8” Ball</li><li>(1) REXMR10-SS – Rod End – Male – 5/8-18 x 5/8” – Shortened .750”</li><li>(2) FSNJ-5/8-18RH – 5/8-18 RH Jam Nut</li><li>(1) FL-SWE715-4PAK – PSC 715 Power Steering Fluid – 4-Quart Pack<br/><br/><br/><br/><br/><br/></li></ul>"
          }
        },
        "kit_category_RYU3V8": {
          "type": "kit_category",
          "settings": {
            "header": "Tools Needed",
            "body": "<ul><li>Pitman arm puller</li><li>5/8” drill bit</li><li>Torque wrench (up to 180 ft-lbs)</li><li>Standard hand tools</li></ul>"
          }
        },
        "step_K6k3PQ": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "{{ page.metafields.custom.step.value }}",
            "label": "Center & Lock the Steering Wheel",
            "body": "<p>Center and lock the steering wheel so the new steering gear lines up exactly like the old one.<br/>(Photo shown is from a previous build, but the process is the same.)</p>",
            "image_1": "{{ page.metafields.custom.instructions_step_1_image.value }}"
          }
        },
        "step_p4UDTU": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "{{ page.metafields.custom.step.value }}",
            "label": "{{ page.metafields.custom.instructions_step_2.value }}",
            "body": "<p><strong>Remove and discard:</strong></p><ul><li>All factory belts</li><li>Factory accessory brackets</li><li>Factory accessories</li><li>OEM water pump and housing&nbsp;<br/></li></ul><p><strong>Remove and retain for installation:</strong></p><ul><li>Alternator</li><li>A/C compressor</li><li>If your A/C uses a stretch belt, OEMs recommend replacing it.<br/><br/><br/><br/><br/></li></ul>",
            "image_1": "{{ page.metafields.custom.instructions_step_2_image.value }}"
          }
        },
        "step_mPKCht": {
          "type": "step",
          "settings": {
            "image_position": "left",
            "header": "{{ page.metafields.custom.step.value }}",
            "label": "Remove Factory Lines",
            "body": "<p>Loosen and remove both factory steering lines.&nbsp;</p><p><br/>Drain fluid into a pan and set lines aside.</p>",
            "image_1": "{{ page.metafields.custom.instructions_step_3_image.value }}"
          }
        },
        "step_Ti9JPh": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "{{ page.metafields.custom.step.value }}",
            "label": "Pull the Pitman Arm",
            "body": "<p>Remove the nut and washer, then use a pitman arm puller to remove the arm completely.</p><p><br/><strong>Tip: </strong>Before you pull the old steering gear, take note of the angle the pitman arm is pointing. That way, when you drop the new steering gear in, everything lines up exactly like the original.<br/></p>",
            "image_1": "{{ page.metafields.custom.instructions_step_4_image.value }}"
          }
        },
        "step_g4dyXM": {
          "type": "step",
          "settings": {
            "image_position": "left",
            "header": "{{ page.metafields.custom.step.value }}",
            "label": "Remove Steering Gear",
            "body": "<p>Take out the (3) bolts that go through the frame and hold the steering gear in place.</p><p><br/>It helps to have someone underneath supporting the gear while you back the bolts out.</p><p><br/>Once it’s free, <strong>pull the gear out through the bottom</strong>.<br/></p>",
            "image_1": "{{ page.metafields.custom.instructions_step_5_image.value }}"
          }
        },
        "step_xkAxXJ": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "{{ page.metafields.custom.step.value }}",
            "label": "Prep for Install",
            "body": "<p>Remove the (2) cylinder assist port caps from the steering gear.&nbsp;</p><p><br/>Clean and inspect all mounting and sealing surfaces before installation.</p><p><br/>Install the new O-rings supplied with the steering gear onto the factory power steering line fittings.<br/></p>",
            "image_1": "{{ page.metafields.custom.instructions_step_6_image.value }}"
          }
        },
        "step_Mw8NCM": {
          "type": "step",
          "settings": {
            "image_position": "right",
            "header": "{{ page.metafields.custom.step.value }}",
            "label": "Install New Gear",
            "body": "<p>Use the (3) factory bolts. Torque to 115 ft-lbs.</p>",
            "image_1": "{{ page.metafields.custom.instructions_step_7_image.value }}"
          }
        },
        "step_V3gA8w": {
          "type": "step",
          "settings": {
            "image_position": "split",
            "header": "{{ page.metafields.custom.step.value }}",
            "label": "Install Pitman Arm",
            "body": "<p>Factory arm goes back on with lock-nut and washer. Torque to 180 ft-lbs.<br/></p>",
            "image_1": "{{ page.metafields.custom.instructions_step_8_image.value }}",
            "image_4": "shopify://shop_images/ADK-LT100_Pic_19.jpg"
          }
        },
